# Local build-time environment. Gitignored — see .gitignore (.env and .env.*).
#
# CF_WEB_ANALYTICS_TOKEN
#   The beacon token from Cloudflare dashboard -> Web Analytics -> your site.
#   It is a 32-character hex string. Set the same variable in the Cloudflare
#   Pages project (Settings -> Environment variables -> Production AND Preview),
#   otherwise production builds render no beacon.
#
#   Leave it empty locally and no beacon script is emitted at all, which is why
#   `astro dev` never pings a real dashboard.
CF_WEB_ANALYTICS_TOKEN=

# PUBLIC_GA_MEASUREMENT_ID
#   Google Analytics 4 measurement id, "G-XXXXXXXXXX", from GA4 -> Admin -> Data streams -> Web.
#   Read at build time, so it must be set where the build runs: the Cloudflare Pages project,
#   Production AND Preview. A value set only in a local shell produces a build with no tag and
#   no error - which is how this went unnoticed until the notification started reporting it.
#
#   Without it nothing is rendered and the build is identical to before. With it, the gtag loader
#   and a bundled bootstrap are emitted; the CSP already permits googletagmanager.com and
#   google-analytics.com, and check-csp verifies that on every page.
PUBLIC_GA_MEASUREMENT_ID=

# PUBLIC_GOOGLE_SITE_VERIFICATION
#   The content value from Search Console's HTML-tag verification method, rendered as
#   <meta name="google-site-verification">.
#
#   ONLY NEEDED FOR A URL-PREFIX PROPERTY. A Domain property (sc-domain:example.com) is verified through
#   DNS and never carries a meta tag - which is the case here, so this is normally left empty. Leaving it
#   empty is not a failure and the daily card does not treat it as one.
PUBLIC_GOOGLE_SITE_VERIFICATION=
