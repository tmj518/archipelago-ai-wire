---
// 主题系列聚合页：/series/[series-slug]/
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const series = await getCollection('series');
  return series.map((s) => ({ params: { slug: s.data.slug }, props: { series: s } }));
}

const { series } = Astro.props;
const posts = (await getCollection('posts')).filter((p) =>
  (p.data.target_keyword || '').includes(series.data.slug) || (p.data.related || []).includes(series.id)
);
---
<BaseLayout title={series.data.title} description={series.data.description}>
  <h1>{series.data.title}</h1>
  <p class="muted">{series.data.description}</p>
  <h2 style="font-size:20px;margin-top:24px;">Articles</h2>
  {posts.length === 0 && <p class="muted">No articles in this series yet.</p>}
  {posts.map((p) => (
    <div class="card"><a href={`/articles/${p.id}/`}><strong>{p.data.title}</strong></a></div>
  ))}
</BaseLayout>
