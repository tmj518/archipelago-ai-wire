---
/**
 * Policy change tracker.
 *
 * Built by copying the benchmark's fourth navigation item rather than inventing a
 * new one. TariffsChart's tracker is a source-backed list of policy regimes, each
 * with a status, an effective window, a link to a guide and a link to the official
 * notice, under the label "a review prompt rather than a filing conclusion". Its
 * own snapshot currently reports zero notices, because it depends on someone
 * indexing public notices by hand.
 *
 * This is the same shape with a different and cheaper source: the dates come from
 * the articles themselves. Every piece states a date on which the underlying
 * instrument changes and a reviewBy date on which it will be re-checked, so the
 * tracker is computed rather than curated.
 *
 * One distinction is stated on the page rather than blurred, because blurring it
 * would mislead: a review date is when we re-check our analysis, which is not the
 * same claim as a policy effective date. Each card shows both.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { fitTitle, fitDescription } from "../lib/meta";

const TODAY = new Date("2026-10-07T00:00:00Z");

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => (a.data.reviewBy?.getTime() ?? Infinity) - (b.data.reviewBy?.getTime() ?? Infinity),
);

const dayDiff = (d) => Math.round((d.getTime() - TODAY.getTime()) / 86400000);
const fmt = (d) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric", timeZone: "UTC" });

/**
 * Buckets, matching the benchmark's status vocabulary: something active now,
 * something about to change, and something being watched.
 *
 * The 30-day line is not arbitrary — it is the window in which a buyer is
 * usually already pricing the order, so a change inside it is actionable rather
 * than merely interesting.
 */
function status(days) {
  if (days < 0) return { key: "overdue", label: "Review overdue" };
  if (days <= 30) return { key: "due", label: "Re-check within 30 days" };
  if (days <= 90) return { key: "soon", label: "Re-check within 90 days" };
  return { key: "watch", label: "Watching" };
}

const rows = posts.map((p) => {
  const days = p.data.reviewBy ? dayDiff(p.data.reviewBy) : null;
  return {
    slug: p.id,
    title: p.data.title,
    category: p.data.category,
    stakes: p.data.stakes ?? "directional",
    reviewBy: p.data.reviewBy,
    reviewIn: days,
    status: days === null ? { key: "watch", label: "No date set" } : status(days),
    sources: p.data.sources?.length ?? 0,
    figures: p.data.figures?.length ?? 0,
    revisions: p.data.revisions?.length ?? 0,
    lastRevision: p.data.revisions?.at(-1)?.date ?? null,
  };
});

const counts = {
  due: rows.filter((r) => r.status.key === "due").length,
  soon: rows.filter((r) => r.status.key === "soon").length,
  watch: rows.filter((r) => r.status.key === "watch").length,
  overdue: rows.filter((r) => r.status.key === "overdue").length,
};
const totalSources = rows.reduce((a, r) => a + r.sources, 0);

const title = "Policy change tracker";
const description =
  "Every dated policy change this site tracks, with the date it takes effect, the date the analysis is re-checked, and a named source for each. A review prompt, not a filing conclusion.";
---

<BaseLayout title={`${fitTitle(title, "", SITE.name)} — ${SITE.name}`} description={description}>
  <div class="container">
    <main id="main">
      <article>
        <header class="article-header">
          <h1>{title}</h1>
          <p class="standfirst">
            Every dated change this site tracks, in the order it needs re-checking.
            Each row names its source. Nothing here is a filing conclusion.
          </p>
        </header>

        <div class="prose">
          <div class="tracker-summary">
            <div class="tracker-stat">
              <span class="tracker-num">{counts.due}</span>
              <span class="tracker-lbl">to re-check within 30 days</span>
            </div>
            <div class="tracker-stat">
              <span class="tracker-num">{counts.soon}</span>
              <span class="tracker-lbl">within 90 days</span>
            </div>
            <div class="tracker-stat">
              <span class="tracker-num">{counts.watch}</span>
              <span class="tracker-lbl">being watched</span>
            </div>
            <div class="tracker-stat">
              <span class="tracker-num">{totalSources}</span>
              <span class="tracker-lbl">named sources behind them</span>
            </div>
          </div>

          {counts.overdue > 0 && (
            <p class="tracker-alert">
              <strong>{counts.overdue}</strong> piece{counts.overdue === 1 ? " is" : "s are"} past the
              re-check date. Treat {counts.overdue === 1 ? "its" : "their"} figures as unconfirmed until
              the note is updated.
            </p>
          )}

          <h2>What is being tracked, and when</h2>

          <table class="tracker-table">
            <thead>
              <tr>
                <th>Status</th>
                <th>Re-check by</th>
                <th>Change</th>
                <th>Sources</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class={`tracker-row tracker-${r.status.key}`}>
                  <td>
                    <span class={`tracker-pill tracker-pill-${r.status.key}`}>{r.status.label}</span>
                  </td>
                  <td class="tracker-date">
                    {r.reviewBy ? fmt(r.reviewBy) : "—"}
                    {r.reviewIn !== null && r.reviewIn >= 0 && r.reviewIn <= 90 && (
                      <span class="tracker-in"> in {r.reviewIn}d</span>
                    )}
                  </td>
                  <td>
                    <a href={`/blog/${r.slug}/`}>{r.title}</a>
                    <span class="tracker-meta">
                      {r.category.replace(/-/g, " ")} · {r.stakes}
                      {r.revisions > 0 && ` · ${r.revisions} visible correction${r.revisions > 1 ? "s" : ""}`}
                    </span>
                  </td>
                  <td class="tracker-num-cell">{r.sources}</td>
                </tr>
              ))}
            </tbody>
          </table>

          <h2>What a date here does and does not mean</h2>
          <p>
            A row means the analysis behind that piece rests on an instrument with a
            date on it, and that the piece will be re-read against the primary source
            on or before the date shown. It does <strong>not</strong> mean the policy
            changes on that date. Where a change has a date of its own, the article
            states it and names where it is published.
          </p>
          <p>
            The re-check date is deliberately earlier than the change where the
            instrument allows it, because a buyer pricing an order needs the corrected
            figure before the order is placed, not after.
          </p>

          <blockquote>
            <strong>A missing or uncertain figure is safer than a confident guess.</strong>
            Where a source could not be read — a paywalled advisory, a PDF that would
            not parse, a page behind a bot wall — the article says so rather than
            filling the gap.
          </blockquote>

          <h2>Where to check the primary sources yourself</h2>
          <p>
            Each article lists its own sources. The registers behind them are these:
          </p>
          <ul>
            <li>
              <a href="https://www.federalregister.gov/" rel="noopener">Federal Register</a>
              — United States rules, notices and effective dates.
            </li>
            <li>
              <a href="https://ustr.gov/issue-areas/enforcement/section-301-investigations/tariff-actions" rel="noopener">USTR</a>
              — Section 301 determinations and exclusions.
            </li>
            <li>
              <a href="https://hts.usitc.gov/" rel="noopener">USITC HTS</a>
              — the United States tariff schedule.
            </li>
            <li>
              <a href="https://eur-lex.europa.eu/" rel="noopener">EUR-Lex</a>
              — EU regulations, including CBAM and safeguard measures.
            </li>
            <li>
              <a href="https://www.boe.es/" rel="noopener">BOE</a>
              — Spanish official state gazette, for measures published there.
            </li>
          </ul>
        </div>
      </article>
    </main>

    <aside class="sidebar">
      <div class="widget">
        <h2>Get the changes</h2>
        <p>
          Duty changes are published with dates. When one moves a per-unit cost,
          it becomes an article.
        </p>
        <p><a href="/rss.xml">RSS feed</a></p>
      </div>
      <div class="widget">
        <h2>Work out your own cost</h2>
        <p>
          The <a href="/calculator/">landed-cost calculator</a> turns a rate and a
          shipment into duty per unit and per container.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
