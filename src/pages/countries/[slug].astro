---
// 国别区域政策专题页：/countries/[country-slug]/
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const countries = await getCollection('countries');
  return countries.map((c) => ({ params: { slug: c.data.slug }, props: { country: c } }));
}

const { country } = Astro.props;
const posts = (await getCollection('posts')).filter((p) =>
  (p.data.target_keyword || '').includes(country.data.slug) || (p.data.related || []).includes(country.id)
);
---
<BaseLayout title={country.data.title} description={country.data.description}>
  <h1>{country.data.title}</h1>
  <p class="muted">{country.data.description}</p>
  <h2 style="font-size:20px;margin-top:24px;">Articles</h2>
  {posts.length === 0 && <p class="muted">No articles for this country yet.</p>}
  {posts.map((p) => (
    <div class="card"><a href={`/articles/${p.id}/`}><strong>{p.data.title}</strong></a></div>
  ))}
</BaseLayout>
