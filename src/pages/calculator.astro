---
/**
 * Calculators.
 *
 * Copied from the benchmark's shape rather than invented: TariffsChart leads its
 * navigation with a free landed-cost calculator and sells a human-prepared check
 * on top. Ours exposes the same models the articles are built from, so a figure
 * published in a piece can be recomputed here instead of taken on trust.
 *
 * Two modes, chosen because each answers a decision a reader is making now:
 *
 *   - Landed cost from FOB, the base case, all destinations.
 *   - Low-value parcel, EU, which changed on 1 July 2026 and changes again on
 *     1 November 2026 when the EUR 2 handling fee starts. That is 25 days away,
 *     which makes it the most actionable number on the site.
 *
 * A third mode was considered and dropped: the export duty on Chinese raw
 * materials. It is genuinely priced and the article carries the schedule, but the
 * rate depends on a customs decision a reader does not control, so a calculator
 * would have implied a precision the tariff schedule does not offer.
 *
 * The arithmetic is NOT reimplemented from scratch. The landed-cost model mirrors
 * src/lib/models.mjs, and the per-item model mirrors tools/per-item-charge.mjs.
 * Both are marked where they are mirrored: a static page has no server, so the
 * models are inlined, and if either changes this must change with it or the page
 * will disagree with our own published figures.
 *
 * Everything runs client-side. No request carries the reader's shipment data, so
 * the privacy page's promise of no tracking scripts holds on the one page where a
 * reader types real numbers.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
import { fitTitle, fitDescription } from "../lib/meta";

const title = "Landed Cost Calculator for China Imports";
const description =
  "The landed cost calculator: put in your FOB price, freight and duty rate and see the true cost per unit and per container, with every tariff layer listed separately - including the ones most calculators leave out. Nothing you type leaves your browser.";

/*
 * This page ranked 89th for "landed cost calculator" - the name of the thing it is.
 *
 * Search Console, 2026-10-26: one impression, position 89. The phrase was present but split across a
 * hyphen and a plural, and it never led the title or the h1. A result is matched on what leads it, so the
 * title now opens with the exact words a reader types; the "for China Imports" tail is what makes it ours
 * rather than a generic widget.
 *
 * The WebApplication block is new. It is the schema that tells a search engine this is a tool rather than
 * an article, which is the difference between appearing under "calculators" and appearing under "guides".
 */
const webApplication = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "Landed Cost Calculator",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Any",
  url: `${SITE.url}/calculator/`,
  description,
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
};
---

<BaseLayout title={`${fitTitle(title, "", SITE.name)} — ${SITE.name}`} description={description} jsonLd={webApplication}>
  <div class="container">
    <main id="main">
      <article>
        <header class="article-header">
          <h1>{title}</h1>
          <p class="standfirst">
            A landed cost calculator for shipments out of China: put in the FOB price, the freight and the
            duty rate, and read the true cost per unit and per container with every layer separated.
            Nothing you type leaves your browser.
          </p>
        </header>

        <div class="prose">
          <p>
            Importers rarely lose money because they cannot multiply a duty rate by
            a shipment value. They lose it because one tariff layer was missing from
            the model: the base rate is counted and the additional listed rate is
            not, or a country average is treated as a product-specific figure, or a
            flat per-item charge that grows as the basket gets cheaper is left out
            entirely. Each calculator below keeps the layers separate so you can see
            which one is doing the damage.
          </p>

          <div class="calc">
            <div class="calc-modes" role="tablist" aria-label="Calculator">
              <button type="button" class="calc-mode" data-mode="landed" role="tab" aria-selected="true">
                Landed cost
              </button>
              <button type="button" class="calc-mode" data-mode="parcel" role="tab" aria-selected="false">
                Low-value parcel (EU)
              </button>
              <button type="button" class="calc-mode" data-mode="cbam" role="tab" aria-selected="false">
                CBAM cost per tonne
              </button>
            </div>

            <!-- Mode 1: landed cost -->
            <div class="calc-panel" data-panel="landed">
              <fieldset>
                <legend>Your shipment</legend>
                <div class="calc-grid">
                  <label>
                    <span>FOB value per unit</span>
                    <input id="fobUnit" type="number" min="0" step="0.01" value="12.00" inputmode="decimal" />
                  </label>
                  <label>
                    <span>Units per container</span>
                    <input id="units" type="number" min="1" step="1" value="5000" inputmode="numeric" />
                  </label>
                  <label>
                    <span>Base duty rate (%)</span>
                    <input id="mfn" type="number" min="0" step="0.1" value="0" inputmode="decimal" />
                  </label>
                  <label>
                    <span>Additional listed rate (%), e.g. Section 301</span>
                    <input id="s301" type="number" min="0" step="0.1" value="25" inputmode="decimal" />
                  </label>
                  <label>
                    <span>Freight per container (optional)</span>
                    <input id="freight" type="number" min="0" step="1" value="0" inputmode="decimal" />
                  </label>
                  <label>
                    <span>Insurance (% of FOB, optional)</span>
                    <input id="insurance" type="number" min="0" step="0.1" value="0" inputmode="decimal" />
                  </label>
                </div>
              </fieldset>
              <div class="calc-result" id="result-landed" aria-live="polite"></div>
            </div>

            <!-- Mode 2: EU low-value parcel -->
            <div class="calc-panel" data-panel="parcel" hidden>
              <fieldset>
                <legend>Your consignment</legend>
                <div class="calc-grid">
                  <label>
                    <span>Items in the consignment</span>
                    <input id="items" type="number" min="1" step="1" value="3" inputmode="numeric" />
                  </label>
                  <label>
                    <span>Value per item (EUR)</span>
                    <input id="itemValue" type="number" min="0" step="0.01" value="3.34" inputmode="decimal" />
                  </label>
                  <label>
                    <span>VAT rate (%) — leave 0 to exclude</span>
                    <input id="vatRate" type="number" min="0" step="0.1" value="0" inputmode="decimal" />
                  </label>
                  <label>
                    <span>Consignment value above EUR 150?</span>
                    <select id="aboveThreshold">
                      <option value="no" selected>No — the EUR 3 duty applies</option>
                      <option value="yes">Yes — no EUR 3 duty, fee still applies</option>
                    </select>
                  </label>
                </div>
              </fieldset>
              <div class="calc-result" id="result-parcel" aria-live="polite"></div>
              <p class="calc-note">
                The EUR 3 per-item duty runs from 1 July 2026 under Regulation (EU)
                2026/2108. The EUR 2 Union handling fee applies from 1 November 2026.
                Both amounts are published figures; the item count and value are
                yours. The fee is per item and does not care what the item is worth,
                which is why the effective rate rises as the basket gets cheaper.
              </p>
            </div>

            <!-- Mode 3: CBAM cost per tonne -->
            <div class="calc-panel" data-panel="cbam" hidden>
              <fieldset>
                <legend>Your import</legend>
                <div class="calc-grid">
                  <label>
                    <span>CN code — steel and aluminium only</span>
                    <select id="cbamCn"></select>
                  </label>
                  <label>
                    <span>Certificate price quarter</span>
                    <select id="cbamQuarter"></select>
                  </label>
                  <label>
                    <span>Declaration year</span>
                    <select id="cbamYear"></select>
                  </label>
                  <label>
                    <span>Tonnes (optional)</span>
                    <input id="cbamTonnes" type="number" min="0" step="0.001" value="0" inputmode="decimal" />
                  </label>
                </div>
              </fieldset>
              <div class="calc-result" id="result-cbam" aria-live="polite"></div>
              <p class="calc-note">
                Default values are the corrected Annex I to Regulation (EU) 2026/1740
                for Chinese origin; benchmarks are Annex point 5 of Regulation (EU)
                2025/2620; the certificate price is the Commission's published figure
                for the quarter. The CBAM factor is the share of free allocation
                <em>still in place</em>, so it is the share of the benchmark that is
                deducted — not a charge on the bill.
              </p>
            </div>

            <p class="calc-note">
              A planning estimate, not a filing calculation. Classification, origin,
              valuation, anti-dumping scope and preference eligibility are decided by
              customs, not by arithmetic — see
              <a href="/sources/">how the sources work</a>.
            </p>
          </div>

          <h2>What the layers are</h2>
          <p>
            Each rate below is published and checkable. The last two are generally
            something a buyer sets themselves, and getting one of those wrong moves
            the estimate by more than most price negotiations do.
          </p>
          <table>
            <thead>
              <tr><th>Layer</th><th>Who publishes it</th><th>Where to check it</th></tr>
            </thead>
            <tbody>
              <tr>
                <td>Base duty rate</td>
                <td>The importing country's tariff schedule</td>
                <td>HTSUS for the United States; TARIC for the EU</td>
              </tr>
              <tr>
                <td>Additional listed rate</td>
                <td>Section 301 determinations in the US; anti-dumping and countervailing measures in the EU</td>
                <td>USTR for Section 301; the Official Journal for EU measures</td>
              </tr>
              <tr>
                <td>Per-item duty and handling fee</td>
                <td>The EU, for consignments below the relief threshold</td>
                <td>Regulation (EU) 2026/2108 and the delegated act setting the fee</td>
              </tr>
              <tr>
                <td>Freight and insurance</td>
                <td>Your forwarder and your broker</td>
                <td>Your own quotation — no public figure applies to your lane</td>
              </tr>
            </tbody>
          </table>

          <h2>Where this is worked through in full</h2>
          <ul>
            <li>
              <a href="/blog/eu-per-item-customs-charge-2026/">The EU per-item charge</a>
              — the schedule the parcel calculator reproduces, with the statutory deadline and the date of the fee.
            </li>
            <li>
              <a href="/blog/section-301-exclusions-expire-november-2026/">The Section 301 exclusion cliff</a>
              — what the same shipment costs when an exclusion expires on 9 November 2026.
            </li>
            <li>
              <a href="/blog/us-vs-eu-low-value-parcel-charges-2026/">The same parcel into the US and the EU</a>
              — why one route costs three times the other.
            </li>
          </ul>

          <blockquote>
            <strong>A missing or uncertain figure is safer than a confident guess.</strong>
            Where this site cannot source a number, it says so on the article rather
            than filling the gap.
          </blockquote>
        </div>
      </article>
    </main>

    <aside class="sidebar">
      <div class="widget">
        <h2>What changes, and when</h2>
        <p>
          The <a href="/tracker/">tracker</a> lists every dated change these models
          depend on, with the date each one is re-checked.
        </p>
      </div>
      <div class="widget">
        <h2>Get the changes</h2>
        <p>
          Duty changes are published with dates. When one moves a per-unit cost, it
          becomes an article.
        </p>
        <p><a href="/rss.xml">RSS feed</a></p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  /*
   * Landed cost — mirrored from src/lib/models.mjs.
   */
  function landedCost(s) {
    const {
      fobUnit,
      unitsPerContainer,
      mfnRate,
      section301Rate,
      otherDutyRate = 0,
      freightPerContainer = 0,
      insuranceRate = 0,
    } = s;
    const dutyRate = mfnRate + section301Rate + otherDutyRate;
    const dutyPerUnit = fobUnit * dutyRate;
    const freightPerUnit = unitsPerContainer > 0 ? freightPerContainer / unitsPerContainer : 0;
    const insurancePerUnit = fobUnit * insuranceRate;
    const landedPerUnit = fobUnit + dutyPerUnit + freightPerUnit + insurancePerUnit;
    return {
      dutyRate,
      dutyPerUnit,
      dutyPerContainer: dutyPerUnit * unitsPerContainer,
      freightPerUnit,
      landedPerUnit,
      landedPerContainer: landedPerUnit * unitsPerContainer,
      dutyShareOfFob: fobUnit > 0 ? dutyPerUnit / fobUnit : 0,
    };
  }

  /*
   * Per-item charge — mirrored from tools/per-item-charge.mjs.
   *
   * The EUR 3 duty replaces the relief that only existed up to EUR 150, so a
   * consignment above that threshold is outside it. The handling fee is not
   * value-conditioned and applies either way.
   */
  function perItemCharge(s) {
    const { items, itemValue, dutyPerItem = 3, feePerItem = 2, vatRate = 0, aboveReliefThreshold = false } = s;
    const duty = aboveReliefThreshold ? 0 : items * dutyPerItem;
    const fee = items * feePerItem;
    const value = items * itemValue;
    const vat = value * vatRate;
    const total = duty + fee + vat;
    return {
      value,
      duty,
      fee,
      vat,
      total,
      effectiveRate: value === 0 ? Infinity : total / value,
      chargeOnlyRate: value === 0 ? Infinity : (duty + fee) / value,
    };
  }

  const num = (id) => {
    const el = document.getElementById(id);
    const v = el ? Number(el.value) : 0;
    return Number.isFinite(v) ? v : 0;
  };
  const money = (n, sym = "$") => sym + (Number.isFinite(n) ? n.toFixed(Math.abs(n) < 10 ? 2 : 2) : "—");
  const pctText = (n) => (Number.isFinite(n) ? (n * 100).toFixed(1) + "%" : "—");

  function renderLanded() {
    const out = document.getElementById("result-landed");
    if (!out) return;
    const fobUnit = num("fobUnit");
    const unitsPerContainer = num("units");
    const s = {
      fobUnit,
      unitsPerContainer,
      mfnRate: num("mfn") / 100,
      section301Rate: num("s301") / 100,
      freightPerContainer: num("freight"),
      insuranceRate: num("insurance") / 100,
    };
    const r = landedCost(s);
    const baseOnly = landedCost({ ...s, section301Rate: 0 });
    const extraPerUnit = r.dutyPerUnit - baseOnly.dutyPerUnit;
    const extraPerContainer = r.dutyPerContainer - baseOnly.dutyPerContainer;

    out.innerHTML = `
      <table class="calc-table">
        <tbody>
          <tr><th>Duty rate applied</th><td>${pctText(r.dutyRate)}</td></tr>
          <tr><th>Duty per unit</th><td>${money(r.dutyPerUnit)}</td></tr>
          <tr><th>Duty per container</th><td>${money(r.dutyPerContainer)}</td></tr>
          <tr><th>Freight per unit</th><td>${money(r.freightPerUnit)}</td></tr>
          <tr class="calc-total"><th>Landed cost per unit</th><td>${money(r.landedPerUnit)}</td></tr>
          <tr class="calc-total"><th>Landed cost per container</th><td>${money(r.landedPerContainer)}</td></tr>
        </tbody>
      </table>
      <table class="calc-table">
        <caption>What the additional listed rate adds</caption>
        <tbody>
          <tr><th>Per unit</th><td>${money(extraPerUnit)}</td></tr>
          <tr><th>Per container</th><td>${money(extraPerContainer)}</td></tr>
          <tr><th>As a share of FOB</th><td>${pctText(r.dutyShareOfFob)}</td></tr>
        </tbody>
      </table>
    `;
  }

  function renderParcel() {
    const out = document.getElementById("result-parcel");
    if (!out) return;
    const above = document.getElementById("aboveThreshold")?.value === "yes";
    const r = perItemCharge({
      items: num("items"),
      itemValue: num("itemValue"),
      vatRate: num("vatRate") / 100,
      aboveReliefThreshold: above,
    });

    /*
     * The comparison that carries the lesson: the same total spend spread across
     * more, cheaper items costs more, because the charge is per item and does not
     * care what each one is worth.
     */
    const items = Math.max(1, num("items"));
    const sameValueOneItem = perItemCharge({
      items: 1,
      itemValue: r.value,
      vatRate: num("vatRate") / 100,
      aboveReliefThreshold: above,
    });

    out.innerHTML = `
      <table class="calc-table">
        <tbody>
          <tr><th>Consignment value</th><td>${money(r.value, "€")}</td></tr>
          <tr><th>Duty at €3 per item</th><td>${money(r.duty, "€")}</td></tr>
          <tr><th>Handling fee at €2 per item</th><td>${money(r.fee, "€")}</td></tr>
          ${r.vat > 0 ? `<tr><th>VAT</th><td>${money(r.vat, "€")}</td></tr>` : ""}
          <tr class="calc-total"><th>Total charge</th><td>${money(r.total, "€")}</td></tr>
          <tr><th>Charge as a share of goods value</th><td>${pctText(r.chargeOnlyRate)}</td></tr>
        </tbody>
      </table>
      <table class="calc-table">
        <caption>Same spend, one item instead of ${items}</caption>
        <tbody>
          <tr><th>Total charge</th><td>${money(sameValueOneItem.total, "€")}</td></tr>
          <tr><th>Difference</th><td>${money(r.total - sameValueOneItem.total, "€")}</td></tr>
        </tbody>
      </table>
    `;
  }

  /*
   * CBAM per-tonne cost — mirrored from src/lib/cbam.mjs, which the CLI also uses.
   *
   * The tables are the law: corrected Annex I defaults for Chinese origin
   * (Reg (EU) 2026/1740), benchmarks (Reg (EU) 2025/2620 Annex point 5), the
   * phase-in factor and CSCF (Guidance Document No. 4, Table 2-1), and the
   * Commission's published quarterly certificate prices.
   */
  var CBAM_PHASE_IN = {
    2025: { factor: 1.0, cscf: 1.0 },
    2026: { factor: 0.975, cscf: 1.0 },
    2027: { factor: 0.95, cscf: 1.0 },
    2028: { factor: 0.9, cscf: 1.0 },
    2029: { factor: 0.775, cscf: 1.0 },
    2030: { factor: 0.515, cscf: 1.0 },
    2031: { factor: 0.39, cscf: 1.0 },
    2032: { factor: 0.265, cscf: 1.0 },
    2033: { factor: 0.14, cscf: 1.0 },
    2034: { factor: 0.0, cscf: 1.0 },
  };

  var CBAM_MARKUP = {
    steel: { 2026: 0.1, 2027: 0.2, 2028: 0.3 },
    aluminium: { 2026: 0.1, 2027: 0.2, 2028: 0.3 },
    fertiliser: { 2026: 0.01, 2027: 0.01, 2028: 0.01 },
  };

  var CBAM_PRICES = {
    "Q1 2026": { price: 75.36, published: "2026-04-07" },
    "Q2 2026": { price: 75.28, published: "2026-07-06" },
  };

  /** CN -> [description, default value total tCO2eq/t, sector] */
  var CBAM_DEFAULTS = {
    "7208": ["Flat-rolled non-alloy steel, 600 mm or more, hot-rolled, in coils", 3.187, "steel"],
    "7209": ["Flat-rolled non-alloy steel, 600 mm or more, cold-rolled", 3.205, "steel"],
    "7210": ["Flat-rolled non-alloy steel, 600 mm or more, clad, plated or coated", 3.205, "steel"],
    "7213": ["Wire rod, hot-rolled, in irregularly wound coils", 3.169, "steel"],
    "7216": ["Angles, shapes and sections of iron or non-alloy steel", 3.169, "steel"],
    "7305": ["Other tubes and pipes, circular, external diameter over 406.4 mm", 2.5, "steel"],
    "7308": ["Structures and parts of structures, of iron or steel", 3.169, "steel"],
    "7601": ["Unwrought aluminium", 13.106, "aluminium"],
    "7603": ["Aluminium powders and flakes", 13.106, "aluminium"],
    "7605": ["Aluminium wire", 13.1, "aluminium"],
    "7606": ["Aluminium plates, sheets and strip, thickness over 0.2 mm", 13.1, "aluminium"],
    "7607": ["Aluminium foil, thickness not exceeding 0.2 mm", 13.1, "aluminium"],
    "7608": ["Aluminium tubes and pipes", 13.1, "aluminium"],
    "7207 11 11": ["Semi-finished non-alloy free-cutting steel", 3.169, "steel"],
    "7214 20 00": ["Bars and rods with indentations or ribs (rebar)", 3.169, "steel"],
    "7225 11 00": ["Flat-rolled silicon-electrical steel, 600 mm or more, grain-oriented", 8.09, "steel"],
    "7304 11 00": ["Seamless line pipe for oil and gas, stainless", 7.005, "steel"],
    "7304 19": ["Seamless line pipe for oil and gas, other", 2.68, "steel"],
    "7306 19 00": ["Other tubes and pipes, welded, circular", 2.5, "steel"],
    "7318 15": ["Screws, bolts, nuts and similar articles, of iron or steel", 3.169, "steel"],
    "7318 16": ["Screws, bolts, nuts and similar articles, of stainless steel", 4.5, "steel"],
    "7604 10 10": ["Aluminium bars, rods and profiles, of non-alloy aluminium", 13.1, "aluminium"],
    "7610 10 00": ["Aluminium structures, doors, windows and their frames", 13.1, "aluminium"],
  };

  /** CN -> benchmark BMg tCO2eq/t. */
  var CBAM_BENCHMARKS = {
    "7207 11 11": 1.364, "7208": 1.37, "7209": 1.458, "7210": 1.491, "7213": 1.364,
    "7214 20 00": 1.364, "7216": 1.364, "7225 11 00": 1.779, "7304 11 00": 1.173,
    "7304 19": 1.364, "7305": 1.458, "7306 19 00": 1.458, "7308": 1.491,
    "7318 15": 1.364, "7318 16": 1.364, "7601": 1.423, "7603": 1.506,
    "7604 10 10": 1.485, "7605": 1.485, "7606": 1.485, "7607": 1.599,
    "7608": 1.493, "7610 10 00": 1.493,
  };

  var cbamRound = function (n, dp) {
    return Number(n.toFixed(dp === undefined ? 6 : dp));
  };

  function cbamPerTonne(cn, year, price) {
    var row = CBAM_DEFAULTS[cn];
    if (!row) return null;
    var description = row[0], dvTotal = row[1], sector = row[2];
    var bmg = CBAM_BENCHMARKS[cn];
    var phase = CBAM_PHASE_IN[year];
    if (bmg === undefined || !phase) return null;
    var markup = CBAM_MARKUP[sector][Math.min(year, 2028)];
    if (markup === undefined) markup = CBAM_MARKUP[sector][2028];
    var embedded = dvTotal * (1 + markup);
    var sefa = bmg * phase.factor * phase.cscf;
    var chargeable = embedded - sefa;
    return {
      cn: cn,
      description: description,
      sector: sector,
      year: year,
      defaultValue: dvTotal,
      markupPct: markup * 100,
      embedded: cbamRound(embedded, 4),
      benchmark: bmg,
      cbamFactorPct: phase.factor * 100,
      cscf: phase.cscf,
      sefa: cbamRound(sefa, 5),
      chargeable: cbamRound(chargeable, 5),
      price: price,
      eurPerTonne: price ? cbamRound(chargeable * price, 2) : null,
      faaShareOfBillPct: cbamRound((sefa / embedded) * 100, 1),
    };
  }

  // Populate the option sets from the tables, so the interface can never offer a
  // code, year or quarter the model does not hold.
  (function fillCbamOptions() {
    var cnSel = document.getElementById("cbamCn");
    if (cnSel) {
      var bySector = { steel: [], aluminium: [] };
      for (var cn in CBAM_DEFAULTS) bySector[CBAM_DEFAULTS[cn][2]].push(cn);
      for (var sector in bySector) {
        var group = document.createElement("optgroup");
        group.label = sector.charAt(0).toUpperCase() + sector.slice(1);
        bySector[sector].forEach(function (code, i) {
          var o = document.createElement("option");
          o.value = code;
          o.textContent = code + " — " + CBAM_DEFAULTS[code][0];
          if (code === "7208") o.selected = true;
          group.appendChild(o);
        });
        cnSel.appendChild(group);
      }
    }
    var qSel = document.getElementById("cbamQuarter");
    if (qSel) {
      for (var q in CBAM_PRICES) {
        var oq = document.createElement("option");
        oq.value = q;
        oq.textContent = q + " — EUR " + CBAM_PRICES[q].price + " per tCO2e";
        qSel.appendChild(oq);
      }
    }
    var ySel = document.getElementById("cbamYear");
    if (ySel) {
      Object.keys(CBAM_PHASE_IN).forEach(function (y) {
        var oy = document.createElement("option");
        oy.value = y;
        oy.textContent = y === "2026" ? y + " (current)" : y;
        if (y === "2026") oy.selected = true;
        ySel.appendChild(oy);
      });
    }
  })();

  function renderCbam() {
    var out = document.getElementById("result-cbam");
    if (!out) return;
    var cn = document.getElementById("cbamCn")?.value;
    var quarter = document.getElementById("cbamQuarter")?.value || "Q1 2026";
    var year = Number(document.getElementById("cbamYear")?.value || 2026);
    var tonnes = num("cbamTonnes");
    var price = CBAM_PRICES[quarter]?.price;
    var r = cbamPerTonne(cn, year, price);
    if (!r) { out.innerHTML = "<p>That code is not in the published default-value table.</p>"; return; }

    /*
     * The escalator, which is the point of the law and which a single-year figure
     * hides: the certificate price is held flat here deliberately, so what the
     * table shows is the free-allocation phase-out alone. Same price, same goods,
     * more cost each year.
     */
    var years = Object.keys(CBAM_PHASE_IN).map(Number).sort(function (a, b) { return a - b; });
    var traj = years.map(function (y) { return cbamPerTonne(cn, y, price); });

    out.innerHTML =
      '<table class="calc-table"><tbody>' +
      "<tr><th>Default value, corrected Annex I</th><td>" + r.defaultValue + " tCO2eq/t</td></tr>" +
      "<tr><th>x (1 + " + r.markupPct + "% mark-up, " + r.year + ")</th><td>" + r.embedded + " tCO2eq/t</td></tr>" +
      "<tr><th>Benchmark BMg</th><td>" + r.benchmark + " tCO2e/t</td></tr>" +
      "<tr><th>x CBAM factor " + r.cbamFactorPct + "% x CSCF " + r.cscf + "</th><td>SEFA " + r.sefa + " tCO2e/t</td></tr>" +
      '<tr class="calc-total"><th>Chargeable emissions</th><td>' + r.chargeable + " tCO2eq/t</td></tr>" +
      "<tr><th>x " + price + " EUR/tCO2e (" + quarter + ")</th><td>" + money(r.eurPerTonne, "€") + " per tonne</td></tr>" +
      "<tr><th>Free-allocation adjustment removes</th><td>" + r.faaShareOfBillPct + "% of the bill</td></tr>" +
      (tonnes > 0
        ? '<tr class="calc-total"><th>For ' + tonnes + " tonnes</th><td>" + money(r.eurPerTonne * tonnes, "€") + "</td></tr>"
        : "") +
      "</tbody></table>" +
      '<table class="calc-table"><caption>Same code, same certificate price, every phase-in year</caption><tbody>' +
      traj.map(function (t) {
        return (
          "<tr" + (t.year === year ? ' class="calc-total"' : "") + "><th>" + t.year +
          " &middot; factor " + t.cbamFactorPct + "%</th><td>" + money(t.eurPerTonne, "€") + " per tonne</td></tr>"
        );
      }).join("") +
      "</tbody></table>";
  }

  // Mode switching.
  const modes = document.querySelectorAll(".calc-mode");
  const panels = document.querySelectorAll(".calc-panel");
  function selectMode(mode) {
    for (const m of modes) m.setAttribute("aria-selected", String(m.dataset.mode === mode));
    for (const p of panels) {
      if (p.dataset.panel === mode) p.removeAttribute("hidden");
      else p.setAttribute("hidden", "");
    }
  }
  for (const m of modes) m.addEventListener("click", () => selectMode(m.dataset.mode));

  for (const id of ["fobUnit", "units", "mfn", "s301", "freight", "insurance"]) {
    document.getElementById(id)?.addEventListener("input", renderLanded);
  }
  for (const id of ["items", "itemValue", "vatRate", "aboveThreshold"]) {
    document.getElementById(id)?.addEventListener("input", renderParcel);
    document.getElementById(id)?.addEventListener("change", renderParcel);
  }
  for (const id of ["cbamCn", "cbamQuarter", "cbamYear"]) {
    document.getElementById(id)?.addEventListener("change", renderCbam);
  }
  document.getElementById("cbamTonnes")?.addEventListener("input", renderCbam);

  renderLanded();
  renderParcel();
  renderCbam();
</script>
