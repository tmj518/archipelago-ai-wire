---
/**
 * The instrument index.
 *
 * A catalogue of the primary documents this site has read, not a list of articles. It
 * exists for two reasons: a reader who has a document number and wants to know what it
 * means for landed cost, and a search engine that needs a crawlable path to the pages.
 *
 * Sorted by how many figures the instrument supplied, because that is a measure of how
 * much of this site's arithmetic depends on it.
 */
import Sidebar from "../../components/Sidebar.astro";
import { SITE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { numbersFor, published } from "../../lib/post";
import registry from "../../data/instruments.json";
import { getCollection } from "astro:content";
import { fitTitle, fitDescription } from "../../lib/meta";

const all = published(await getCollection("blog"));
const numbers = numbersFor(all);
const bySlug = new Map(all.map((p) => [p.id, p]));

const instruments = registry.instruments
  .map((i) => {
    const source = i.source;
    const shortName = source.split(/,\s*(?=[A-Z0-9])/)[0].trim();
    const identifier =
      /\b\d{2}\s+FR\s+\d+/.exec(source)?.[0] ??
      /\((?:EU|EC|EEC)\)\s*\d{4}\/\d+/.exec(source)?.[0] ??
      /No\.\s*\d+\s+of\s+\d{4}/.exec(source)?.[0] ??
      null;
    return {
      id: i.id,
      name: shortName,
      identifier,
      figureCount: i.figures.length,
      articleCount: i.articleSlugs.length,
      categories: [...new Set(i.articleSlugs.map((s) => bySlug.get(s)?.data.category).filter(Boolean))],
    };
  })
  .sort((a, b) => b.figureCount - a.figureCount || a.name.localeCompare(b.name));

const totalFigures = instruments.reduce((a, i) => a + i.figureCount, 0);

const title = "Instruments";
const description =
  `${instruments.length} primary instruments — regulations, customs announcements, official gazettes and statistical releases — ` +
  `supplying ${totalFigures} sourced figures to this site. Each links to its figures and to the articles that cite it.`;
---

<BaseLayout
  title={`${fitTitle(title, "", SITE.name)} — ${SITE.name}`}
  description={description}
  pageType="CollectionPage"
>
  <div class="container">
    <main id="main">
      <div class="page-head">
        <h1>Instruments</h1>
        <p>
          The primary documents behind the numbers: {instruments.length} instruments supply
          {" "}{totalFigures} of the figures on this site. Each page lists every value read from that
          instrument, the article that relies on it, and how to cite it.
        </p>
        <p class="empty-note">
          Documents that supplied a single figure are not listed here yet — a page holding one number
          is not worth a URL. They join this index as later articles draw more from the same source.
        </p>
      </div>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Instrument</th>
              <th>Identifier</th>
              <th class="num">Figures</th>
              <th class="num">Articles</th>
            </tr>
          </thead>
          <tbody>
            {instruments.map((i) => (
              <tr>
                <td><a href={`/instrument/${i.id}/`}>{i.name}</a></td>
                <td class="mono">{i.identifier ?? "—"}</td>
                <td class="num">{i.figureCount}</td>
                <td class="num">{i.articleCount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>

    <Sidebar numbers={numbers} />
  </div>
</BaseLayout>

<style>
  .table-wrap {
    overflow-x: auto;
    margin: 20px 0;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.94rem;
  }
  th,
  td {
    border-bottom: 1px solid var(--rule, #e5e5e5);
    padding: 9px 10px;
    text-align: left;
    vertical-align: top;
  }
  th {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .num {
    text-align: right;
    white-space: nowrap;
  }
  .mono {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.88rem;
    white-space: nowrap;
  }
</style>
