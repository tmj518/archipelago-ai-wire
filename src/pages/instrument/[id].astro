---
/**
 * One page per primary instrument.
 *
 * Why this node and not a page per figure.
 *
 * The benchmark treats its citable unit as the thing a number came from, not the number
 * itself. Measured against this corpus on 2026-10-08: 207 figure records resolve to 199
 * distinct data points, a reuse ratio of 1.04, so a page per figure would be 199 pages
 * each holding a single number. That is the thin-content outcome the no-volume rule
 * exists to prevent.
 *
 * The instrument level does hold. Those same 207 figures come from 131 distinct
 * documents, and 28 of them carry real depth - at least two figures, or cited by at
 * least two articles - after excluding the 25 that are Landed Math's own model output
 * rather than an external document. A model is methodology, not a citable instrument.
 *
 * What makes the page substantial rather than thin:
 *   - every figure drawn from this instrument, with its five-part record
 *   - every article that relies on it, which is the reverse link that makes it a node
 *   - what the instrument is, and what we could and could not read from it
 *   - a citation block, which is the mechanism the benchmark uses to get cited
 *
 * The registry is generated by a script rather than written by hand, so the page count
 * follows the data: as articles accrue figures from the same documents, documents cross
 * the depth threshold and appear without anyone editing a list.
 */
import { getCollection } from "astro:content";

import Sidebar from "../../components/Sidebar.astro";
import { SITE, SITE_URL } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { numbersFor, published } from "../../lib/post";
import registry from "../../data/instruments.json";
import { fitTitle, fitDescription } from "../../lib/meta";

export async function getStaticPaths() {
  const posts = published(await getCollection("blog"));
  const bySlug = new Map(posts.map((p) => [p.id, p]));

  return registry.instruments.map((instrument) => ({
    params: { id: instrument.id },
    props: {
      instrument,
      cited: instrument.articleSlugs
        .map((s) => bySlug.get(s))
        .filter(Boolean)
        .map((p) => ({
          href: `/blog/${p.id}/`,
          number: p.data.articleNumber,
          title: p.data.title,
          category: p.data.category,
          date: p.data.publishDate,
        }))
        .sort((a, b) => (a.number ?? 0) - (b.number ?? 0)),
    },
  }));
}

const { instrument, cited } = Astro.props;

const all = published(await getCollection("blog"));
const numbers = numbersFor(all);

/**
 * The instrument's name.
 *
 * This used to cut the source string at its first comma, on the theory that the part before the comma
 * is the institution and the rest is detail. The detail is the point. Four pages titled themselves
 * "European Commission" - the product safety sweep, the CBAM certificate price, the notice of
 * initiation and a duplicate sweep record - and search engines showed four identical entries for four
 * different documents. The same happened to the customs announcements, where "No. 74 of 2026" and
 * "No. 40 of 2026" are the only difference that matters.
 *
 * So the whole source is the name now, with only a trailing publication clause removed, because
 * "published 8 September 2026" and "released 10 September 2026" describe when it was read rather than
 * what it is, and they sit at the end where they are cheapest to drop.
 */
const source = instrument.source;
/*
 * The source, with a repeated publisher prefix moved out of the title.
 *
 * Two instruments from the same agency were producing identical sixty-column titles, because the publisher
 * is identical on both and the distinguishing clause sits after the first comma - so truncating from the
 * front kept the shared part and discarded the difference.
 *
 * The publisher is not lost: it is in the description, in the citation metadata and in the JSON-LD, which is
 * where a reader looking for provenance finds it. The title spends its budget on what separates this
 * document from the other one.
 *
 * Narrow on purpose. Only when the first comma-separated part has no digits and is shorter than the rest - a
 * source whose leading segment carries the identifying number, such as "91 FR 51975", is left alone.
 */
const cleaned = source.replace(/,\s*(?:published|released|retrieved|via)\b[^,]*$/i, "").replace(/\s+/g, " ").trim();
const commaAt = cleaned.indexOf(",");
const head = commaAt > 0 ? cleaned.slice(0, commaAt).trim() : "";
const tail = commaAt > 0 ? cleaned.slice(commaAt + 1).trim() : "";
/*
 * Is the leading segment a publisher rather than the name?
 *
 * The first version compared lengths, which works when the distinguishing clause is long and fails when it
 * is short - and a short tail is exactly the case where the shared prefix is most of the title. A publisher
 * is recognisable on its own terms: more than twenty columns and no digits. A segment carrying "91 FR 51975"
 * has digits and is therefore never treated as a prefix.
 */
const publisherIsShared = commaAt > 0 && !/\d/.test(head) && head.length > 14;
const name = (publisherIsShared ? tail : cleaned).trim();

/**
 * A stable identifier, pulled out of the source string when one is present.
 *
 * Journal citations like "91 FR 51975", regulation numbers like "(EU) 2026/1740", and announcement
 * numbers like "No. 136 of 2026" were already handled. Three more shapes are read now because they are
 * the only thing distinguishing two instruments that are otherwise named identically:
 *
 *   "Industrial Producer Price Indexes in August 2026"   the month, which the other release omits
 *   "2026 tariff adjustment plan, export duty schedule"  the annex, versus the plan itself
 *   "product safety sweep results, annex"                the same, for the sweep
 *
 * Month names are matched before prose numbers so "August 2026" is not read as a bare figure, and
 * "No. 74 of 2026" is shortened to "No. 74/2026" because every character saved here is a character
 * available to the name.
 */
const MONTHS = "January|February|March|April|June|July|August|September|October|November|December";
const months = [...new Set([...source.matchAll(new RegExp(`\\b(?:${MONTHS})\\s+20\\d{2}\\b`, "g"))].map((m) => m[0]))].join(", ");
const clause =
  /\b(annex(?:\s+\d+)?|export duty schedule|import duty schedule|table\s+\d+|section\s+\d+|part\s+\d+|Article\s+\d+)\b/i.exec(source)?.[0] ?? "";
const identifier =
  /\b\d{2}\s+FR\s+\d+/.exec(source)?.[0] ??
  /\((?:EU|EC|EEC)\)\s*\d{4}\/\d+/.exec(source)?.[0] ??
  /(No\.\s*\d+)\s+of\s+\d{4}/.exec(source)?.slice(1).join("/") ??
  /国市监[^\s,，]{0,12}\d+号/.exec(source)?.[0] ??
  null;

/**
 * A parenthetical inside the publisher's name is a qualifier, not part of the publisher.
 *
 * "(in Preparation)", "(draft)", "(revised)" - these describe the document's status and are often the only
 * thing separating two releases from the same agency. Lifting one out means it lands in the qualifier, which
 * is appended outside the truncation, so it cannot be the part that gets cut.
 */
const statusQualifier = /\(([^)]{2,40})\)/.exec(head)?.[1] ?? "";

/**
 * Month, clause and status are appended when there is no formal number, which is when they are all there is.
 */
const qualifier = identifier ?? [months, clause, statusQualifier].filter(Boolean).join(", ");


const figures = instrument.figures;

/*
 * The complete title, suffix included, inside 60 display columns.
 *
 * The qualifier - an announcement number, a month, an annex - is passed separately so the name is what gets
 * shortened and the distinguishing part survives. fitTitle subtracts the suffix from the budget, so this is
 * the width a result actually shows.
 */
const title = `${fitTitle(name, qualifier, SITE.name, 60)} — ${SITE.name}`;
/*
 * The publisher leads the description when the title dropped it.
 *
 * The title moves a repeated publisher out of its sixty columns so the distinguishing clause survives. That
 * is only honest if the publisher is still visible, and a reader deciding whether to trust a figure wants
 * the agency before the figure.
 */
const publisherPrefix = publisherIsShared ? `${head}. ` : "";
const description =
  `${publisherPrefix}${figures.length} figure${figures.length === 1 ? "" : "s"} on this site come from ${name}` +
  `${qualifier ? ` (${qualifier})` : ""}, cited by ${cited.length} ` +
  `article${cited.length === 1 ? "" : "s"}. Every value carries its unit, period, source and retrieval date.`;

const pageUrl = `${SITE_URL}/instrument/${instrument.id}/`;
const retrievedDates = [...new Set(figures.map((f) => f.retrieved).filter(Boolean))].sort();

/**
 * JSON-LD, passed to the layout as a prop rather than written as a script tag here.
 *
 * The layout collects its own site and page blocks and appends whatever the page supplies
 * through `jsonLd`; a hand-written script in the body would state the page's identity a
 * second time and would not be seen by the duplicate-type check.
 *
 * A Dataset is the closest schema.org type to "a set of measured values with provenance".
 * It is not a CreativeWork, and claiming Article or WebPage here would be wrong. The
 * isBasedOn link points at the instrument itself, which is what a citation needs.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: title,
  description,
  url: pageUrl,
  creator: { "@type": "Organization", name: SITE.name, url: SITE_URL },
  isBasedOn: source,
  variableMeasured: [...new Set(figures.map((f) => f.unit))].slice(0, 12),
  datePublished: retrievedDates[0],
  dateModified: retrievedDates[retrievedDates.length - 1],
  citation: cited.map((c) => ({ "@type": "Article", headline: c.title, url: `${SITE_URL}${c.href}` })),
};
---

<BaseLayout
  title={title}
  description={fitDescription(description)}
  jsonLd={jsonLd}
>
  <div class="container">
    <main id="main">
      <div class="page-head">
        <p class="eyebrow"><a href="/instrument/">Instruments</a></p>
        <h1>{name}</h1>
        {qualifier && <p class="instrument-id">{qualifier}</p>}
        <p>
          {figures.length} figure{figures.length === 1 ? "" : "s"} on this site come from this
          instrument, cited by {cited.length} article{cited.length === 1 ? "" : "s"}. Each value
          below carries the five-part record: value, unit, period, named source and retrieval date.
        </p>
      </div>

      <h2 class="section-title">What this instrument is</h2>
      <blockquote>
        <p><strong>Source as cited</strong> — {source}</p>
      </blockquote>
      <p>
        Figures below are read from the instrument itself rather than from coverage of it. Where a
        value could not be read — a bot wall, a PDF that would not parse, an empty response — that is
        recorded on the article that relied on it, and counted on <a href="/sources/">the sources page</a>.
      </p>

      <h2 class="section-title">Figures drawn from it</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Value</th>
              <th>Unit</th>
              <th>Period</th>
              <th>Retrieved</th>
            </tr>
          </thead>
          <tbody>
            {figures.map((f) => (
              <tr>
                <td><strong>{f.value}</strong></td>
                <td>{f.unit}</td>
                <td>{f.period}</td>
                <td>{f.retrieved}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="empty-note">
        Source for every row above: {source}. Retrieved {retrievedDates.join(", ")}.
      </p>

      <h2 class="section-title">Articles citing it</h2>
      {cited.map((c) => (
        <p class="instrument-cite">
          <a href={c.href}>{c.title}</a>
          <span class="instrument-cite-meta">
            {c.number ? `#${c.number} · ` : ""}{c.category} · {c.date}
          </span>
        </p>
      ))}

      <h2 class="section-title">Cite this</h2>
      <p>
        Every value on this page is traceable to the instrument named above, on the retrieval date
        shown. Cite the instrument, not this page, when the number matters:
      </p>
      <blockquote>
        <p>{source}. Retrieved {retrievedDates.join(", ")}. Compiled at {pageUrl}</p>
      </blockquote>
    </main>

    <Sidebar numbers={numbers} />
  </div>
</BaseLayout>

<style>
  .eyebrow {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 8px;
  }
  .instrument-id {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.95rem;
    opacity: 0.75;
    margin-top: -6px;
  }
  .table-wrap {
    overflow-x: auto;
    margin: 16px 0;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.94rem;
  }
  th,
  td {
    border-bottom: 1px solid var(--rule, #e5e5e5);
    padding: 8px 10px;
    text-align: left;
    vertical-align: top;
  }
  th {
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.7;
  }
  .instrument-cite {
    margin: 10px 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .instrument-cite-meta {
    font-size: 0.85rem;
    opacity: 0.7;
  }
</style>
