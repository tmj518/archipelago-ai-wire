---
/**
 * One dated brief.
 *
 * The benchmark's dated page carries the day's items, a subscribe line at the top, and links
 * to the neighbouring dates. Same structure here, with one substitution: where TLDR lists
 * links out to other people's reporting, each row here is an analysis of our own, so the row
 * shows the title, the reading time, and the sourced figure count - three fields, no summary,
 * which is the format the operator asked for.
 *
 * The subscribe line is at the top rather than the bottom because someone reading an archive
 * page from two weeks ago is the reader most likely to want the next one.
 */
import { getCollection } from "astro:content";

import Sidebar from "../../components/Sidebar.astro";
import { SITE, formatDate, categoryLabel } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { numbersFor, published } from "../../lib/post";
import { briefsFor } from "../../lib/brief.mjs";
import { fitTitle, fitDescription } from "../../lib/meta";

export async function getStaticPaths() {
  const posts = published(await getCollection("blog"));
  const briefs = briefsFor(posts);

  return briefs.map((brief, i) => ({
    params: { date: brief.date },
    props: {
      brief,
      newer: briefs[i - 1] ?? null,
      older: briefs[i + 1] ?? null,
    },
  }));
}

const { brief, newer, older } = Astro.props;

const posts = published(await getCollection("blog"));
const numbers = numbersFor(posts);
const bySlug = new Map(posts.map((p) => [p.id, p]));

const dayPosts = brief.items.map((i) => bySlug.get(i.slug)).filter(Boolean);
const figuresToday = dayPosts.reduce((a, p) => a + (p.data.figures?.length ?? 0), 0);
const sourcesToday = dayPosts.reduce((a, p) => a + (p.data.sources?.length ?? 0), 0);

const title = `${brief.date} brief`;
const description =
  `${brief.items.length} ${brief.items.length === 1 ? "analysis" : "analyses"} published on ${brief.date}: ` +
  brief.items.map((i) => i.title).join("; ").slice(0, 160);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.url}/brief/${brief.date}/#page`,
  url: `${SITE.url}/brief/${brief.date}/`,
  name: `${title} — ${SITE.name}`,
  description,
  inLanguage: SITE.language,
  isPartOf: { "@id": `${SITE.url}/#website` },
  hasPart: brief.items.map((i) => ({
    "@type": "Article",
    headline: i.title,
    url: `${SITE.url}/blog/${i.slug}/`,
  })),
};
---

<BaseLayout title={`${fitTitle(title, "", SITE.name)} — ${SITE.name}`} description={fitDescription(description)} jsonLd={jsonLd}>
  <div class="container">
    <main id="main">
      <div class="page-head">
        <p class="crumb"><a href="/brief/">← All briefs</a></p>
        <h1>{brief.date}</h1>
        <p>
          {brief.items.length} {brief.items.length === 1 ? "analysis" : "analyses"} published ·{" "}
          <strong>{figuresToday}</strong> sourced figures · <strong>{sourcesToday}</strong> named
          primary sources
        </p>
        <p class="subscribe-line">
          <a href="/#subscribe">Subscribe free</a> — one email when a tracked change moves a
          per-unit cost. No daily filler.
        </p>
      </div>

      <div class="brief-items">
        {brief.items.map((item) => (
          <div class="brief-item">
            <h2>
              <a href={`/blog/${item.slug}/`}>{item.title}</a>
            </h2>
            <p class="brief-fields">
              <span class="field">{categoryLabel(item.category)}</span>
              <span class="sep">·</span>
              <span class="field">{item.minutes} min read</span>
              <span class="sep">·</span>
              <span class="field">
                {bySlug.get(item.slug)?.data.figures?.length ?? 0} figures
              </span>
            </p>
            <p class="brief-desc">{item.description}</p>
          </div>
        ))}
      </div>

      <nav class="brief-nav">
        {older ? <a href={`/brief/${older.date}/`}>← {older.date}</a> : <span />}
        {newer ? <a href={`/brief/${newer.date}/`}>{newer.date} →</a> : <span />}
      </nav>
    </main>

    <Sidebar numbers={numbers} />
  </div>
</BaseLayout>

<style>
  .crumb {
    font-size: 0.86rem;
    margin-bottom: 6px;
  }
  .subscribe-line {
    font-size: 0.92rem;
    opacity: 0.85;
  }
  .brief-items {
    margin: 24px 0;
  }
  .brief-item {
    padding: 16px 0;
    border-top: 1px solid var(--rule, #e8e8e8);
  }
  .brief-item h2 {
    font-size: 1.12rem;
    margin: 0 0 6px;
    line-height: 1.38;
  }
  .brief-fields {
    font-family: var(--mono, ui-monospace, SFMono-Regular, Menlo, monospace);
    font-size: 0.78rem;
    opacity: 0.7;
    margin: 0 0 6px;
  }
  .sep {
    margin: 0 5px;
  }
  .brief-desc {
    font-size: 0.94rem;
    opacity: 0.9;
    margin: 0;
  }
  .brief-nav {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 26px 0 10px;
    padding-top: 16px;
    border-top: 1px solid var(--rule, #e8e8e8);
    font-size: 0.9rem;
  }
</style>
