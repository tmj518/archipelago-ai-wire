---
// 首页：信息流列表（对标 Malaysiakini / tldr.tech）
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1);
---
<BaseLayout title="Archipelago Intel — Decision memos for cross-border business" description="Neutral, source-backed policy decision memos for Southeast Asian and Latin American SMEs.">
  <div class="max-w-7xl mx-auto px-4 py-6">
    <!-- Desktop 双栏：主栏70% + 侧栏30%；移动端单栏 -->
    <div class="md:flex gap-8">
      <!-- 主栏 -->
      <div class="md:w-7/12 lg:w-8/12">
        <!-- 头条 -->
        {featured && (
          <a href={`/articles/${featured.id}/`} class="block group mb-8">
            <div class="aspect-video bg-bg-soft rounded-lg mb-4 overflow-hidden">
              <!-- 封面图占位 -->
              <div class="w-full h-full bg-gradient-to-br from-brand to-blue-700 flex items-center justify-center text-white/30 text-4xl font-bold">
                AI
              </div>
            </div>
            <h2 class="text-2xl md:text-3xl font-bold group-hover:text-accent transition">
              {featured.data.title}
            </h2>
            <p class="text-muted mt-2 line-clamp-2">{featured.data.description}</p>
            <div class="text-xs text-muted mt-2">
              {featured.data.pubDate.toLocaleDateString('en-GB')} · ~6 min read
            </div>
          </a>
        )}

        <!-- 信息流列表 -->
        <div class="divide-y divide-border">
          {rest.map((post) => (
            <a href={`/articles/${post.id}/`} class="block py-4 group">
              <div class="flex gap-4">
                <div class="w-24 h-24 md:w-32 md:h-32 bg-bg-soft rounded shrink-0 overflow-hidden">
                  <div class="w-full h-full bg-gradient-to-br from-brand/60 to-blue-500/60"></div>
                </div>
                <div class="flex-1 min-w-0">
                  <h3 class="font-bold group-hover:text-accent transition line-clamp-2">
                    {post.data.title}
                  </h3>
                  <p class="text-sm text-muted mt-1 line-clamp-2">{post.data.description}</p>
                  <div class="text-xs text-muted mt-2">
                    {post.data.pubDate.toLocaleDateString('en-GB')} · ~5 min read
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- 侧边栏（移动端隐藏） -->
      <aside class="hidden md:block md:w-5/12 lg:w-4/12">
        <!-- 广告位 -->
        <div class="bg-bg-soft rounded p-4 text-center text-xs text-muted mb-6">
          <!-- ADSENSE_SLOT_SIDEBAR --> Advertisement
        </div>

        <!-- 订阅引导 -->
        <div class="bg-brand text-white rounded p-5 mb-6">
          <h3 class="font-bold text-lg mb-2">Get the daily memo</h3>
          <p class="text-sm text-gray-300 mb-3">5 minutes a day. Neutral, source-backed analysis.</p>
          <a href="/subscribe/" class="block bg-accent text-center py-2 rounded font-bold text-sm hover:opacity-90">
            Subscribe free
          </a>
        </div>

        <!-- 热门文章 -->
        <div class="bg-white border border-border rounded p-5">
          <h3 class="font-bold mb-3 text-sm uppercase tracking-wide text-muted">Popular</h3>
          {posts.slice(0, 5).map((post, i) => (
            <a href={`/articles/${post.id}/`} class="flex gap-3 py-2 border-b border-border last:border-0">
              <span class="text-accent font-bold text-lg">{i + 1}</span>
              <span class="text-sm font-medium line-clamp-2">{post.data.title}</span>
            </a>
          ))}
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
