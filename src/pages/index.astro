---
import { getCollection } from "astro:content";

import ArticleRow from "../components/ArticleRow.astro";
import FeaturedCard from "../components/FeaturedCard.astro";
import HeroLead from "../components/HeroLead.astro";
import Sidebar from "../components/Sidebar.astro";
import { AUTHOR, SITE, formatDate } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  leadStory,
  numbersFor,
  published,
  readingTime,
  toCard,
} from "../lib/post";
import { MIN_CLUSTER, slugify } from "../lib/topics";

const posts = published(await getCollection("blog"));

/*
 * The topic hubs, counted here so the homepage can link to them.
 *
 * Astro resolves the topic route separately, so the front page has to do its own clustering rather
 * than importing getStaticPaths. The two use the same slugify and the same floor from lib/topics,
 * which is what keeps a link from pointing at a page that was never generated.
 */
const topics = (() => {
  const counts = new Map<string, { tag: string; count: number }>();
  for (const p of posts) {
    for (const tag of p.data.tags ?? []) {
      const slug = slugify(tag);
      if (!slug) continue;
      const cur = counts.get(slug);
      if (cur) cur.count++;
      else counts.set(slug, { tag, count: 1 });
    }
  }
  return [...counts.entries()]
    .filter(([, v]) => v.count >= MIN_CLUSTER)
    .map(([slug, v]) => ({ slug, tag: v.tag, count: v.count }))
    .sort((a, b) => b.count - a.count || a.tag.localeCompare(b.tag));
})();

const heroPost = leadStory(posts);
const featuredPost =
  posts.find((post) => post.data.featured && post.id !== heroPost?.id) ??
  posts.find((post) => post.id !== heroPost?.id);

const latest = posts
  .filter((post) => post.id !== heroPost?.id && post.id !== featuredPost?.id)
  .slice(0, 6)
  .map(toCard);

const numbers = numbersFor(posts);

/*
 * Corpus totals for the first screen, counted from the articles rather than written down.
 *
 * The benchmark's version of this line is a subscriber count and a list of well-known
 * readers. We have neither, and stating one would be the failure this site is built to
 * avoid. Counting at build time means the numbers cannot drift: adding an article changes
 * them, and no one has to remember to edit a headline.
 */
const figures = posts.reduce((a, p) => a + (p.data.figures?.length ?? 0), 0);
const sources = posts.reduce((a, p) => a + (p.data.sources?.length ?? 0), 0);

/*
 * The homepage is an index of the published analysis, so it declares itself as one.
 *
 * The WebSite block that used to live here is gone: BaseLayout now emits the site,
 * organisation and breadcrumb blocks on every page, and two WebSite blocks on one page
 * is the kind of duplicate that makes a machine pick the wrong node.
 */
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${SITE.url}/#page`,
  url: `${SITE.url}/`,
  name: SITE.title,
  description: SITE.description,
  inLanguage: SITE.language,
  isPartOf: { "@id": `${SITE.url}/#website` },
};
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={jsonLd}>
  {/*
    * The first screen states what this is, who it is for, and offers one action.
    *
    * It used to lead with the newest article's title, which told a first-time visitor
    * nothing about the product and gave them no way to subscribe without scrolling.
  */}
  <HeroLead
    analyses={posts.length}
    figures={figures}
    sources={sources}
    latestHref={heroPost ? `/blog/${heroPost.id}/` : "#latest"}
  />

  <div class="container">
    <main id="main">
      {
        heroPost && (
          <div class="lead-story" id="latest">
            <h2 class="section-title">Latest analysis</h2>
            <ArticleRow
              href={`/blog/${heroPost.id}/`}
              date={`${formatDate(heroPost.data.publishDate)} · ${readingTime(heroPost.body)} min read`}
              title={heroPost.data.title}
              excerpt={heroPost.data.description}
            />
          </div>
        )
      }

      {
        featuredPost && (
          <FeaturedCard
            href={`/blog/${featuredPost.id}/`}
            title={featuredPost.data.title}
            excerpt={featuredPost.data.description}
            category={featuredPost.data.category}
            priority={featuredPost.data.priority}
            image={featuredPost.data.heroImage}
            imageAlt={featuredPost.data.heroImageAlt}
          />
        )
      }

      {/*
        The rest of the corpus, and the empty state only when the corpus really is empty.

        With one article published, the lead story above is also the whole corpus, so this block used
        to print "Nothing published yet" directly under a headline announcing it - the false-empty
        state the first piece exposed. The heading is only worth printing when there is something
        beneath it, and the empty note belongs to the no-articles case, not the one-article case.
      */}
      {latest.length > 0 && (
        <section class="more-analysis">
          <h2 class="section-title">More analysis</h2>
          {latest.map((item) => (
            <ArticleRow
              href={item.href}
              date={item.date}
              title={item.title}
              excerpt={item.excerpt}
            />
          ))}
        </section>
      )}

      {posts.length === 0 && (
        <>
          <h2 class="section-title" id="latest">
            Latest analysis
          </h2>
          <p class="empty-note">
            Nothing published yet. The first explainers are being checked against their source
            documents — <a href="/about/">how this is made</a>.
          </p>
        </>
      )}

      {/*
        Browse by topic — mechanism 4 of the benchmark study, surfaced where it can be found.
        A hub page with nothing linking to it is not published, which this project has already
        learned the hard way, so the homepage carries the entry point. The list is built from the
        corpus at build time and can never go stale; it grows on its own as articles accumulate.
      */}
      {
        topics.length > 0 && (
          <section class="home-topics">
            <h2 class="section-title">Browse by topic</h2>
            <ul class="home-topic-list">
              {topics.map((t) => (
                <li>
                  <a href={`/topic/${t.slug}/`}>
                    {t.tag} <span class="home-topic-count">{t.count}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </main>

    <Sidebar numbers={numbers} showNumbers={posts.length > 0} />
  </div>
</BaseLayout>

<style>
  .home-topics {
    margin-top: 40px;
    padding-top: 22px;
    border-top: 1px solid var(--c-line);
  }
  .home-topic-list {
    list-style: none;
    padding: 0;
    margin: 10px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
  }
  .home-topic-list a {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 13px;
    border: 1px solid var(--c-line);
    border-radius: var(--radius);
    font-size: 13.5px;
    text-decoration: none;
    /* 44px minimum touch target, the same rule the mobile layout gate enforces. */
    min-height: 44px;
  }
  .home-topic-list a:hover {
    border-color: var(--c-red);
  }
  .home-topic-count {
    font-size: 11.5px;
    color: var(--c-ink-4);
    background: var(--c-line-faint);
    border-radius: 999px;
    padding: 1px 7px;
  }
</style>
