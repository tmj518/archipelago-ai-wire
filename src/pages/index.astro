---
// 首页：The Information / Stratechery 极简高级风
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const featured = posts[0];
const rest = posts.slice(1, 6);
---
<BaseLayout title="Archipelago Intel — Decision memos for cross-border business" description="Neutral, source-backed policy decision memos for Southeast Asian and Latin American SMEs.">
  <div class="max-w-3xl mx-auto px-6 py-12">
    <!-- 导语 -->
    <div class="mb-12 pb-8 border-b border-gray-200">
      <p class="text-xs uppercase tracking-widest text-gray-400 mb-4">Daily Brief</p>
      <h2 class="text-3xl md:text-4xl font-serif font-bold leading-tight mb-3">
        What changed in policy, what it means for your bottom line.
      </h2>
      <p class="text-gray-600 leading-relaxed">
        Every weekday, we decode official government releases into a 5-minute decision memo — conclusion first, sources cited, one thing to do this week.
      </p>
    </div>

    <!-- 头条：大标题，无图 -->
    {featured && (
      <a href={`/articles/${featured.id}/`} class="block group mb-10">
        <div class="text-xs text-accent uppercase tracking-wider mb-2">Featured</div>
        <h3 class="text-2xl md:text-3xl font-serif font-bold leading-snug group-hover:text-accent transition">
          {featured.data.title}
        </h3>
        <p class="text-gray-600 mt-3 leading-relaxed">{featured.data.description}</p>
        <div class="text-xs text-gray-400 mt-3">
          {featured.data.pubDate.toLocaleDateString('en-GB')} · 6 min read
        </div>
      </a>
    )}

    <!-- 列表：纯文字，分割线 -->
    <div class="divide-y divide-gray-200">
      {rest.map((post) => (
        <a href={`/articles/${post.id}/`} class="block py-5 group">
          <h4 class="text-lg font-serif font-bold leading-snug group-hover:text-accent transition">
            {post.data.title}
          </h4>
          <p class="text-sm text-gray-500 mt-1 line-clamp-2">{post.data.description}</p>
          <div class="text-xs text-gray-400 mt-2">
            {post.data.pubDate.toLocaleDateString('en-GB')} · 5 min read
          </div>
        </a>
      ))}
    </div>

    <!-- 订阅 CTA -->
    <div class="mt-12 pt-8 border-t border-gray-200 text-center">
      <p class="text-sm text-gray-600 mb-4">Get the daily memo in your inbox. Free, 5 minutes a day.</p>
      <a href="/subscribe/" class="inline-block bg-brand text-white px-8 py-3 font-bold text-sm hover:opacity-90 transition">
        Subscribe free
      </a>
    </div>
  </div>
</BaseLayout>
