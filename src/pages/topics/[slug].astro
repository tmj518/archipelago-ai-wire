---
// 主题专题聚合页：/topics/[topic-slug]/
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const topics = await getCollection('topics');
  return topics.map((t) => ({ params: { slug: t.data.slug }, props: { topic: t } }));
}

const { topic } = Astro.props;
const posts = (await getCollection('posts')).filter((p) =>
  (p.data.target_keyword || '').includes('malaysia') || (p.data.related || []).includes(topic.id)
);
---
<BaseLayout title={topic.data.title} description={topic.data.description}>
  <h1>{topic.data.title}</h1>
  <p class="muted">{topic.data.description}</p>
  <h2 style="font-size:20px;margin-top:24px;">Articles</h2>
  {posts.length === 0 && <p class="muted">No articles in this topic yet.</p>}
  {posts.map((p) => (
    <div class="card"><a href={`/articles/${p.id}/`}><strong>{p.data.title}</strong></a></div>
  ))}
</BaseLayout>
