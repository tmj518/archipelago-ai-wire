---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---
<BaseLayout title="Latest" description="Latest policy, trade, and economy analysis for Southeast Asian business owners.">
  <main class="page">
    <header class="page-header">
      <h1>Latest</h1>
      <p class="page-sub">Deep policy analysis, decoded for people who ship goods.</p>
    </header>

    <div class="post-list">
      {posts.map((p) => (
        <article class="post-item">
          <a href={`/articles/${p.id}/`} class="post-link">
            <h2 class="post-title">{p.data.title}</h2>
            <p class="post-desc">{p.data.description}</p>
            <div class="post-meta">
              <time datetime={p.data.pubDate.toISOString()}>{formatDate(p.data.pubDate)}</time>
              <span class="dot">·</span>
              <span class={`stake stake-${p.data.stakes}`}>{p.data.stakes}</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </main>
</BaseLayout>

<style>
.page {
  max-width: 720px;
  margin: 0 auto;
  padding: 48px 24px 80px;
}

.page-header {
  margin-bottom: 48px;
  padding-bottom: 24px;
  border-bottom: 2px solid #1a1a1a;
}

.page-header h1 {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 2.75rem;
  font-weight: 800;
  line-height: 1.1;
  margin: 0 0 12px;
  color: #1a1a1a;
  letter-spacing: -0.02em;
}

.page-sub {
  font-size: 1.1rem;
  color: #666;
  margin: 0;
}

.post-list {
  display: flex;
  flex-direction: column;
}

.post-item {
  padding: 32px 0;
  border-bottom: 1px solid #e5e5e5;
}

.post-item:last-child {
  border-bottom: none;
}

.post-link {
  text-decoration: none;
  color: inherit;
  display: block;
}

.post-link:hover .post-title {
  color: #0066cc;
}

.post-title {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  font-size: 1.6rem;
  font-weight: 800;
  line-height: 1.3;
  margin: 0 0 10px;
  color: #1a1a1a;
  transition: color 0.15s;
  letter-spacing: -0.01em;
}

.post-desc {
  font-size: 1.05rem;
  line-height: 1.6;
  color: #444;
  margin: 0 0 14px;
}

.post-meta {
  font-size: 0.85rem;
  color: #999;
  display: flex;
  align-items: center;
  gap: 8px;
}

.dot {
  color: #ccc;
}

.stake {
  text-transform: uppercase;
  font-size: 0.75rem;
  font-weight: 600;
  letter-spacing: 0.05em;
}

.stake-priced {
  color: #b8860b;
}

.stake-directional {
  color: #666;
}

@media (max-width: 640px) {
  .page {
    padding: 32px 16px 60px;
  }
  .page-header h1 {
    font-size: 2rem;
  }
  .post-title {
    font-size: 1.25rem;
  }
  .post-desc {
    font-size: 1rem;
  }
}
</style>
