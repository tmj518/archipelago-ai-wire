---
// 定价页：the-ken 风格 + Tailwind 响应式
import BaseLayout from '../layouts/BaseLayout.astro';

const PLANS = [
  {
    name: 'Free',
    price: '$0',
    unit: 'forever',
    popular: false,
    features: [
      { label: 'Daily email brief', included: true },
      { label: 'Ad-free reading', included: true },
      { label: 'Full archive access', included: false },
      { label: 'Weekly trend brief', included: false },
      { label: 'Podcast audio', included: false },
      { label: 'Priority trend projections', included: false },
      { label: 'Source package (for verification)', included: false },
    ],
  },
  {
    name: 'Monthly',
    price: '$9',
    unit: '/month',
    popular: true,
    features: [
      { label: 'Daily email brief', included: true },
      { label: 'Ad-free reading', included: true },
      { label: 'Full archive access', included: true },
      { label: 'Weekly trend brief', included: true },
      { label: 'Podcast audio', included: true },
      { label: 'Priority trend projections', included: false },
      { label: 'Source package (for verification)', included: false },
    ],
  },
  {
    name: 'Yearly',
    price: '$90',
    unit: '/year',
    popular: false,
    features: [
      { label: 'Everything in Monthly', included: true },
      { label: '2 months free', included: true },
      { label: 'Priority trend projections', included: true },
      { label: 'Source package (for verification)', included: true },
      { label: 'Q&A with analyst', included: false },
    ],
  },
  {
    name: 'Lifetime',
    price: '$300',
    unit: 'one-time',
    popular: false,
    features: [
      { label: 'Everything in Yearly', included: true },
      { label: 'No recurring charge', included: true },
      { label: 'Lifetime access', included: true },
      { label: 'Q&A with analyst', included: true },
    ],
  },
];
---
<BaseLayout title="Subscribe — Archipelago Intel" description="Membership plans for cross-border SMEs. Free daily decision memo, paid trend briefs, podcast, and source packages.">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="text-center mb-10">
      <h1 class="text-3xl md:text-4xl font-bold mb-3">
        The only decision memo you need for cross-border business.
      </h1>
      <p class="text-muted max-w-xl mx-auto">
        Neutral, source-backed analysis. Read by cross-border traders, exporters, and small investors who want to be prepared.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      {PLANS.map((plan) => (
        <div class={`bg-white border rounded-lg p-6 relative ${plan.popular ? 'border-brand shadow-lg md:scale-105' : 'border-border'}`}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-brand text-white text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap">
              MOST POPULAR
            </div>
          )}
          <h3 class="font-bold mb-1">{plan.name}</h3>
          <div class="text-4xl font-extrabold mb-1">{plan.price}</div>
          <div class="text-xs text-muted mb-4">{plan.unit}</div>
          <ul class="space-y-2 text-sm mb-6">
            {plan.features.map((f) => (
              <li class={`flex items-start gap-2 ${f.included ? '' : 'text-muted line-through'}`}>
                <span class={f.included ? 'text-accent font-bold' : 'text-muted'}>{f.included ? '✓' : '✗'}</span>
                <span>{f.label}</span>
              </li>
            ))}
          </ul>
          <button class={`w-full py-2.5 rounded font-bold text-sm ${plan.popular ? 'bg-brand text-white hover:opacity-90' : 'bg-bg-soft text-ink hover:bg-border'}`}>
            {plan.price === '$0' ? 'Get started free' : `Subscribe ${plan.name}`}
          </button>
        </div>
      ))}
    </div>

    <div class="text-center mt-10 text-sm text-muted">
      <p>Trusted by cross-border traders, exporters, and small business owners across Malaysia, Indonesia, and Latin America.</p>
      <p class="mt-2">
        Payments via Stripe & PayPal. See <a href="/refund/" class="text-brand underline">Refund Policy</a> · <a href="/privacy/" class="text-brand underline">Privacy</a>.
      </p>
    </div>
  </div>
</BaseLayout>
