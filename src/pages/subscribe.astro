---
// 定价页：the-ken.com/pricing 风格
// 三档 + 中间档 MOST POPULAR + 功能矩阵划掉/高亮
import BaseLayout from '../layouts/BaseLayout.astro';

const PLANS = [
  {
    name: 'Free',
    price: '$0',
    unit: 'forever',
    popular: false,
    features: [
      { label: 'Daily email brief', included: true },
      { label: 'Ad-free reading', included: true },
      { label: 'Full archive access', included: false },
      { label: 'Weekly trend brief', included: false },
      { label: 'Podcast audio', included: false },
      { label: 'Priority trend projections', included: false },
      { label: 'Source package (for verification)', included: false },
    ],
  },
  {
    name: 'Monthly',
    price: '$9',
    unit: '/month',
    popular: true,
    features: [
      { label: 'Daily email brief', included: true },
      { label: 'Ad-free reading', included: true },
      { label: 'Full archive access', included: true },
      { label: 'Weekly trend brief', included: true },
      { label: 'Podcast audio', included: true },
      { label: 'Priority trend projections', included: false },
      { label: 'Source package (for verification)', included: false },
    ],
  },
  {
    name: 'Yearly',
    price: '$90',
    unit: '/year',
    popular: false,
    features: [
      { label: 'Everything in Monthly', included: true },
      { label: '2 months free', included: true },
      { label: 'Priority trend projections', included: true },
      { label: 'Source package (for verification)', included: true },
      { label: 'Q&A with analyst', included: false },
    ],
  },
  {
    name: 'Lifetime',
    price: '$300',
    unit: 'one-time',
    popular: false,
    features: [
      { label: 'Everything in Yearly', included: true },
      { label: 'No recurring charge', included: true },
      { label: 'Lifetime access', included: true },
      { label: 'Q&A with analyst', included: true },
    ],
  },
];
---
<BaseLayout title="Subscribe — Archipelago Intel" description="Membership plans for cross-border SMEs. Free daily decision memo, paid trend briefs, podcast, and source packages.">
  <section style="text-align:center;padding:40px 16px 24px;">
    <h1 style="font-size:36px;max-width:680px;margin:0 auto 12px;">
      The only decision memo you need for cross-border business in ASEAN & LatAm.
    </h1>
    <p style="font-size:17px;color:#555;max-width:560px;margin:0 auto;">
      Neutral, source-backed analysis. Read by cross-border traders, exporters, and small investors who want to be prepared for what comes next.
    </p>
  </section>

  <section style="display:flex;flex-wrap:wrap;gap:16px;max-width:1080px;margin:24px auto;padding:0 16px;">
    {PLANS.map((plan) => (
      <div
        class="card"
        style={`flex:1 1 230px;min-width:230px;position:relative;${plan.popular ? 'border:2px solid #1f6feb;transform:scale(1.03);' : ''}`}
      >
        {plan.popular && (
          <div style="position:absolute;top:-12px;left:50%;transform:translateX(-50%);background:#1f6feb;color:#fff;font-size:11px;font-weight:700;padding:4px 12px;border-radius:12px;white-space:nowrap;">
            MOST POPULAR
          </div>
        )}
        <h3 style="margin:0 0 4px;">{plan.name}</h3>
        <div style="font-size:36px;font-weight:800;margin:8px 0 2px;">{plan.price}</div>
        <div style="font-size:13px;color:#888;margin-bottom:16px;">{plan.unit}</div>
        <ul style="list-style:none;padding:0;margin:0;font-size:13px;">
          {plan.features.map((f) => (
            <li style={`padding:6px 0;border-bottom:1px solid #f0f1f3;${f.included ? '' : 'color:#bbb;text-decoration:line-through;'}`}>
              {f.included ? '✓' : '✗'} {f.label}
            </li>
          ))}
        </ul>
        <button
          style={`margin-top:16px;width:100%;padding:10px;border:none;border-radius:6px;font-weight:700;cursor:pointer;${plan.popular ? 'background:#1f6feb;color:#fff;' : 'background:#f0f1f3;color:#333;'}`}
        >
          {plan.price === '$0' ? 'Get started free' : `Subscribe ${plan.name}`}
        </button>
      </div>
    ))}
  </section>

  <section style="max-width:680px;margin:32px auto;padding:0 16px;font-size:14px;color:#666;text-align:center;">
    <p>
      Trusted by Malaysian exporters, cross-border traders, and small business owners who read trends before they hit the headlines.
    </p>
    <p style="margin-top:16px;">
      Payments via Stripe & PayPal. See <a href="/refund/">Refund Policy</a> · <a href="/privacy/">Privacy</a>.
    </p>
  </section>
</BaseLayout>
