---
/**
 * Refund policy.
 *
 * A P0 page from the benchmark page list, paired with the terms, and the one page a buyer
 * reads when something has gone wrong. The benchmark's pattern, and the reason a policy like
 * this is worth writing before any payment provider is connected: an ambiguous refund policy
 * is what turns a complaint into a chargeback, and a chargeback costs more than the refund.
 *
 * The policy is deliberately unconditional inside the window. A refund policy with
 * conditions invites an argument about whether the conditions were met, and the argument
 * costs more than the refund does. What it asks for instead is a reason, because the reason
 * is the useful part - it says whether the product is wrong or the description was.
 */
import Sidebar from "../components/Sidebar.astro";
import { AUTHOR, SITE } from "../consts";
import BaseLayout from "../layouts/BaseLayout.astro";
import { numbersFor, published } from "../lib/post";
import { getCollection } from "astro:content";
import { fitTitle, fitDescription } from "../lib/meta";

const posts = published(await getCollection("blog"));
const numbers = numbersFor(posts);

const title = "Refunds";
const description =
  "How refunds work for Landed Math subscriptions and one-off reports: the window, the process, and what happens if the analysis turns out to be wrong.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: `Refunds — ${SITE.name}`,
  description,
  url: `${SITE.url}/refund/`,
};

const RULES = [
  {
    when: "Within 30 days of a first payment",
    what: "Full refund, no questions about why. One email is enough.",
  },
  {
    when: "Within 30 days of any renewal",
    what: "Full refund of that renewal. Renewals are the most common accidental charge, so they are treated the same as first payments.",
  },
  {
    when: "A one-off report or the founding tier, within 30 days",
    what: "Full refund of the one-off payment. If the report was a bespoke answer to a named question, see the note below.",
  },
  {
    when: "After 30 days",
    what: "A pro-rata refund is offered on an annual plan if the site stopped publishing. Nothing else is refundable after the window.",
  },
  {
    when: "A figure was wrong and you relied on it",
    what: "Refunded in full regardless of the window. A published error is the one case where the clock does not apply.",
  },
];

const HOW = [
  `Email ${AUTHOR.email} from the address the subscription is under, or any address if you no longer have access to it.`,
  "Say which plan, roughly when it started, and — if you are willing — what was wrong. The reason is optional and it is the only part that changes anything on this end.",
  "It is refunded to the original payment method within five business days, and a one-line confirmation is sent when it is done.",
];
---

<BaseLayout title={`${fitTitle(title, "", SITE.name)} — ${SITE.name}`} description={fitDescription(description)} jsonLd={jsonLd}>
  <div class="container">
    <main id="main">
      <div class="page-head">
        <h1>Refunds</h1>
        <p>
          A short policy, written to be read once. The window is 30 days and the reason is
          optional: a refund policy with conditions invites an argument about whether the
          conditions were met, and the argument costs more than the refund.
        </p>
      </div>

      <div class="callout">
        <span class="callout-label">Current status</span>
        <p>
          <strong>No payment has been taken from anyone.</strong> Paid subscriptions are not
          open, so there is nothing to refund yet. This page exists because a paid tier cannot
          open without it, and because the terms of a refund should be readable before the
          purchase rather than after.
        </p>
      </div>

      <h2 class="section-title">When a refund applies</h2>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Situation</th>
              <th>What happens</th>
            </tr>
          </thead>
          <tbody>
            {RULES.map((r) => (
              <tr>
                <td>{r.when}</td>
                <td>{r.what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 class="section-title">How to ask</h2>
      <ol>
        {HOW.map((s) => (
          <li>{s}</li>
        ))}
      </ol>

      <h2 class="section-title">Why the policy is written this way</h2>
      <p>
        The free tier carries everything published, in full. That means a subscription buys
        cadence and convenience rather than access, and if the cadence is not worth it to you,
        the honest answer is a refund rather than a retention offer. There is no cancellation
        flow designed to make leaving difficult, and no email required to cancel.
      </p>
      <p>
        The exception for a published error is the part that matters. Every figure on this site
        traces to a named primary source with a retrieval date, and every article states which
        claims are established and which are inference. If a number was wrong and you made a
        decision on it, the 30-day window does not apply — the sourcing rules are a promise, and
        a refund is the smallest part of keeping it.
      </p>

      <h2 class="section-title">Cancelling rather than refunding</h2>
      <p>
        To stop future charges, cancel from the link in any email or by asking. Access continues
        until the end of the period already paid for. Cancelling does not trigger a refund by
        itself; ask for one if the window applies and you want it. Both are one email:{" "}
        <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>.
      </p>
    </main>

    <Sidebar numbers={numbers} />
  </div>
</BaseLayout>

<style>
  .table-wrap {
    overflow-x: auto;
    margin: 18px 0;
  }
  table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.93rem;
  }
  th,
  td {
    border-bottom: 1px solid var(--rule, #e5e5e5);
    padding: 9px 10px;
    text-align: left;
    vertical-align: top;
  }
  th {
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    opacity: 0.72;
  }
  td:first-child {
    width: 34%;
  }
  ol {
    padding-left: 20px;
  }
  li {
    margin: 7px 0;
  }
</style>
