---
/**
 * The guide index: every published guide, grouped by cluster.
 *
 * This page exists so that a guide is reachable from something other than the sitemap. A section that
 * only a crawler can find is a section with no internal links, and internal links are the only
 * authority this site can hand a new page.
 *
 * Same article classes as the guide page and the blog: one heading scale, one reading width, one site.
 */
import { getCollection } from "astro:content";

import BaseLayout from "../../layouts/BaseLayout.astro";
import { SITE } from "../../consts";
import { isEmptyArchive } from "../../lib/archive-state.mjs";

const TOPIC_LABEL = {
  money: "Money & tax",
  work: "Work & skills",
  study: "Study & education",
  business: "Business & trade",
  "daily-life": "Daily life & costs",
  "travel-docs": "Travel & documents",
};

const guides = (await getCollection("guide"))
  .filter((g) => g.data.draft !== true)
  .sort((a, b) => String(b.data.lastVerified).localeCompare(String(a.data.lastVerified)));

const byTopic = new Map();
for (const g of guides) {
  const t = g.data.topic;
  if (!byTopic.has(t)) byTopic.set(t, []);
  byTopic.get(t).push(g);
}

const groups = [...byTopic.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout
  title={`Guides — what to do about it — ${SITE.name}`}
  description="Practical guides for Malaysians: what a change costs you, what the steps are, and the date each figure was checked."
  /* No guides yet means nothing to index. The page keeps its own honest empty state; it just does not
     ask to be found while it has no content. */
  noindex={isEmptyArchive(guides.length)}
>
  <main id="main" class="wrap">
    <article>
      <header class="article-header">
        <a class="tag" href="/">Archipelago AI Wire</a>
        <h1>Guides</h1>
        <p class="standfirst">
          The world changed — so what do you actually do about it? Each guide sets out the steps in order,
          names the authority behind every rule, and shows the date each figure was checked.
        </p>
        <div class="meta">{guides.length} guide{guides.length === 1 ? "" : "s"}</div>
      </header>

      <div class="prose">
        {
          guides.length === 0 ? (
            <p>The first guides are being written. Check back shortly.</p>
          ) : (
            groups.map(([topic, items]) => (
              <section>
                <h2>{TOPIC_LABEL[topic] ?? topic}</h2>
                <ul class="guide-list">
                  {items.map((g) => (
                    <li>
                      <a href={`/guide/${g.id}/`}>{g.data.title}</a>
                      <span class="guide-meta">
                        {g.data.unit} · checked {g.data.lastVerified}
                      </span>
                      <p class="guide-excerpt">{g.data.description}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          )
        }
      </div>
    </article>
  </main>
</BaseLayout>

<style>
  .guide-list {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }
  .guide-list li {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    padding: 0.9rem 0;
  }
  .guide-list a {
    font-weight: 700;
  }
  .guide-meta {
    margin-left: 0.6rem;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    opacity: 0.6;
  }
  .guide-excerpt {
    margin: 0.3rem 0 0;
  }
</style>
