---
/**
 * An advertising slot.
 *
 * The front-end brief asks for three placements - a homepage banner, an article sidebar, and
 * an in-article block on mobile - each reserved as a static placeholder with the AdSense
 * script mount point marked rather than embedded.
 *
 * Nothing here loads a script and nothing here renders an ad. That is deliberate and it is
 * the point of the component: the mount point exists so the placement can be judged and
 * filled later, and it renders nothing until then. A placeholder that loads an ad network
 * would break the privacy page's promise - "no advertising networks, no third-party
 * analytics, no tracking scripts" - and that promise is load-bearing, because a
 * reader-supported model is the only one consistent with it.
 *
 * So the slot is a reserved space with the integration documented, and the order of
 * operations is explicit: connecting an ad network means editing the privacy page first,
 * because the promise is a statement of fact that a script would make false.
 *
 * Sizes follow the IAB units the brief's layout implies rather than arbitrary numbers:
 * 728x90 leaderboard or 970x90 for the banner, 300x250 or 300x600 for the sidebar, 300x250
 * inline. The slot reserves the height so filling it later does not shift the layout, which
 * is what causes the worst layout instability on a phone.
 */
export interface Props {
  /** Where it sits, which decides the reserved size and the mobile behaviour. */
  placement: "banner" | "sidebar" | "inline";
  /** Shown in the reserved box so an unfilled slot is not a mystery to a reader. */
  note?: string;
}

const { placement, note } = Astro.props;

const SIZES = {
  banner: { w: 728, h: 90, label: "Leaderboard 728×90" },
  sidebar: { w: 300, h: 250, label: "Medium rectangle 300×250" },
  inline: { w: 300, h: 250, label: "Medium rectangle 300×250" },
};

const size = SIZES[placement];
---

{/*
  * AD MOUNT POINT — placement: {placement}
  *
  * To fill this slot, replace the inner placeholder markup with the ad tag and uncomment the
  * script line. Two conditions before doing so:
  *
  *   1. /privacy/ currently states "no advertising networks, no third-party analytics, no
  *      tracking scripts". That becomes false the moment an ad script loads. The privacy page
  *      must be updated in the same change, not afterwards.
  *   2. The slot has no reserved height on mobile for the banner, because a 728-wide unit
  *      cannot fit a 360-wide screen and scaling it down makes the text illegal to read.
  *
  * <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-XXXXXXXX" crossorigin="anonymous"></script>
  * <ins class="adsbygoogle" style="display:block" data-ad-client="ca-pub-XXXXXXXX" data-ad-slot="XXXXXXXX" data-ad-format="auto" data-full-width-responsive="true"></ins>
  * <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  *
  * The slot is hidden rather than shrunk where the unit cannot fit: a 728x90 leaderboard on a
  * 360px screen is either unreadable or causes the horizontal overflow that the responsive
  * rules exist to prevent.
*/}
{/*
  * Renders nothing, deliberately.
  *
  * The component used to draw a dashed "Advertisement 300×250" box wherever it was placed. On a site
  * whose first screen says "Independent · no ads · no tracking", that box was the one element on the
  * page contradicting the page. A reserved slot is a good idea when an ad is coming; with no ad
  * network connected and no plan to connect one before launch, all it reserved was 250px of nothing.
  *
  * The placement sizes and the integration note stay in this file because the decision they support
  * is still the right one: connecting an ad network means editing /privacy/ in the same change,
  * because that page states as fact that there are none. Restore the markup below at the same time,
  * not before.
  *
  * AD MOUNT POINT — placement: {placement}, reserved size {size.label}
  *
  * <div class:list={["ad-slot", `ad-slot--${placement}`]} data-ad-placement={placement} aria-hidden="true">
  *   <span class="ad-slot__label">Advertisement</span>
  *   <span class="ad-slot__size">{note ?? size.label}</span>
  * </div>
  *
  * and the <style> block that sized it, kept in git history at commit bb49b01.
  */}
