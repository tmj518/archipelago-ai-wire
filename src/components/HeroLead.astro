---
/**
 * The first screen.
 *
 * Five blocks and nothing else: a headline that states the promise, a subtitle that names the
 * audience, three lines saying what the reader gets, one button, and a line of proof.
 *
 * The proof is not a subscriber count. We have no subscribers and no logos, and inventing either is
 * the exact failure this site is built to avoid. What is true and specific is the corpus — how many
 * pieces, how many sourced figures, how many named documents — and it is counted from the articles
 * at build time, so it cannot drift from reality.
 *
 * The instrument count came out with the China registry on 2026-10-26: a count of regulatory
 * filings is a promise this publication does not make.
 */
import { AUTHOR } from "../consts";
import { AUDIENCE, CTA, CTA_NOTE, HEADLINE, SUBTITLE, WHAT_YOU_GET } from "../lib/copy";

export interface Props {
  /** Generated from the published collection, never typed by hand. */
  analyses: number;
  figures: number;
  sources: number;
}

const { analyses, figures, sources } = Astro.props;
---

<header class="hero">
  <div class="hero-inner">
    <div class="kicker">Independent · no ads · no tracking</div>

    <h1>{HEADLINE}</h1>

    <p class="hero-sub">{SUBTITLE}</p>
    <p class="hero-audience">{AUDIENCE}</p>

    <ul class="hero-gets">
      {WHAT_YOU_GET.map((w) => (
        <li>{w}</li>
      ))}
    </ul>

    <div class="hero-cta">
      <a class="hero-button" href="#subscribe">{CTA} →</a>
      <p class="hero-cta-note">{CTA_NOTE}</p>
    </div>

    {/*
      * The proof line, or nothing.
      *
      * Counted from the collection at build time, which was right - and which printed "0 explainers ·
      * 0 sourced figures · 0 named documents" on a live homepage before the first piece was written.
      * A publication announcing that it has published nothing is not being honest, it is being
      * unread: the honest version of zero is a sentence about what is being checked, not a digit.
      */}
    {analyses > 0 ? (
      <p class="hero-proof">
        {analyses} {analyses === 1 ? "explainer" : "explainers"} ·{" "}
        <strong>{figures}</strong> {figures === 1 ? "sourced figure" : "sourced figures"} ·{" "}
        <strong>{sources}</strong> {sources === 1 ? "named document" : "named documents"}
      </p>
    ) : (
      <p class="hero-proof">
        First explainers are being checked against their source documents. Nothing is published
        before every figure has a source and a date.
      </p>
    )}

    <p class="hero-by">
      {AUTHOR.name} · {AUTHOR.role} · <a href="/about/">how this is made</a>
    </p>
  </div>
</header>

<style>
  .hero-sub {
    max-width: 46ch;
    margin: 0 auto 8px;
    font-size: 1.02rem;
    opacity: 0.92;
  }
  .hero-audience {
    max-width: 46ch;
    margin: 0 auto 18px;
    font-size: 0.92rem;
    opacity: 0.78;
  }
  .hero-gets {
    list-style: none;
    padding: 0;
    margin: 0 auto 20px;
    max-width: 34ch;
    text-align: left;
    font-size: 0.92rem;
  }
  .hero-gets li {
    padding: 3px 0 3px 18px;
    position: relative;
  }
  .hero-gets li::before {
    content: "✓";
    position: absolute;
    left: 0;
    opacity: 0.6;
  }
  .hero-cta {
    margin: 22px 0 18px;
  }
  .hero-button {
    display: inline-block;
    padding: 12px 26px;
    border-radius: 4px;
    font-weight: 600;
    text-decoration: none;
    background: var(--accent, #d4573a);
    color: #fff;
  }
  .hero-button:hover {
    text-decoration: none;
    filter: brightness(1.08);
  }
  .hero-cta-note {
    font-size: 0.84rem;
    opacity: 0.72;
    margin: 9px 0 0;
  }
  .hero-proof {
    font-size: 0.92rem;
    opacity: 0.85;
    margin: 0 0 6px;
  }
  .hero-by {
    font-size: 0.88rem;
    opacity: 0.75;
    margin: 0;
  }
</style>
