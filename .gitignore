# build output
dist/
.astro/

# Generated media. `build/video/` held rendered slides, narration and the assembled MP4 —
# tens of megabytes per article. The video pipeline was removed from this project on
# 2026-10-26; the rule stays because the directory is still a build artifact and still large.
build/

# Environment setup scratch
_env_setup/

# Python
__pycache__/
*.pyc

# dependencies
node_modules/

# environment
# `.env.*` covers the whole family of credential files and re-admits only the template.
.env
.env.*
!.env.example
.env.production
.env.local

# Google / YouTube OAuth credentials. The client secret and the cached refresh token are each
# equivalent to an account password. The upload tooling was removed from this project on
# 2026-10-26; the rules stay because the files may still exist on a developer's machine and a
# forgotten credential is the one file nobody notices being committed.
youtube-oauth.json
youtube-token.json
*youtube-oauth*.json
*youtube-token*.json
client_secret*.json
token.json

# Google Search Console service-account key, used by tools/gsc-report.mjs.
#
# A service-account private key is a credential: it grants read access to the Search Console
# property for as long as it exists, with no second factor and no expiry. It was missing from
# this file until 2026-10-08, which meant the key would have been committable the moment
# anyone created it in the project root - the default location the tool documents.
#
# Local alternative: put it under %LOCALAPPDATA%\dsh\ where nothing is tracked at all.
gsc-service-account*.json
*-service-account*.json
.gsc/

# Private keys and certificate bundles.
#
# Nothing of these kinds is tracked today and `git grep` over the index finds no key material; this is the
# rule that keeps it that way when a downloaded key lands in the repository root, which is the default place
# every tool here documents.
#
# Deliberately NOT a blanket `*.key`. The project produces no .key file today, and a rule that wide would
# swallow one that later becomes necessary - a fixture, a keystore - without anyone noticing until a build
# failed for a reason nobody could see. These five are the shapes a private key actually arrives in.
*.pem
id_rsa
id_rsa_*
*.p12
*.pfx

# IndexNow key files are the opposite and are deliberately NOT ignored: the endpoint verifies
# ownership by fetching /<key>.txt and comparing, so the file is meant to be public. See
# tools/submit-urls.mjs.

# logs
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Render output. The rendering pipeline was removed with the previous publication on 2026-10-26;
# the directory is kept out of the repository because it is generated, large, and would turn every
# re-render into a five-thousand-file diff.
data/renders/
data/tmp/

# Exported deliverables: upload payloads built from the renders. A file that gets uploaded
# somewhere is not source, and a repository that tracks it shows a diff every time a figure is
# corrected.
exports/

# editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Cloudflare / Wrangler
.wrangler/
.dev.vars

# Agent scratch space. Research agents download HTML, PDF and text extracts
# here. It is working material, not site content: keeping it out of the repo
# stops multi-megabyte PDFs landing in git history on every `git add -A`.
# The sources are cited by name in each article's frontmatter instead.
_research/
_research_tmp/
_research_*/
*-evidence/
landed-math-dossier-*.txt
*_dossier*.txt
*dossier*.md

# curl -o NONE creates a real file on Windows (NUL is the reserved name)
NONE

# Research agent scratch. Third time this has been swept in by git add -A:
# agents write working files at the repository root, and directory names vary
# by task (cbam/, out/). Patterns now cover the shapes rather than the names.
cbam/
out/
p_*.txt
*.bin
_probe*
fetch.py
fetch.ps1
get.ps1
h2t.py
lang.py
probe.py
search.py
cellar*.py
crop.py

# QA reports are generated per run; data/qa has its own ignore.

# Unattended run transcripts. Useful on disk, not useful in git.
# Archived source bodies. The manifest keeps url, label, bytes and sha256, which is the provenance a figure
# needs; the page itself is re-fetchable and verifiable against that hash. One day of these is 1.5 MB and a year
# is about 550 MB, which is the only thing here that grows without bound.
#
# The small .txt archives stay - a EUR-Lex notice is 40 KB of readable text and cheap to keep.
data/sources/**/*.html

logs/

# Gate results cache. Keyed by input hash, so it is correct to regenerate and never
# worth committing. See tools/gate.mjs and tools/serp-check.mjs.
.cache/

# The C line's staging area. A guide only leaves this directory after it has passed its gates and a
# real astro build, so nothing here is ever an artifact worth keeping.
data/drafts-c/

# Keyword research output.
#
# Seven files under data/keywords/ were committed by accident on 2026-10-26: the cleanup removed the
# directory's own .gitignore first, and the following `git add -A` swept the CSVs back in. They are
# timestamped output from a generator (tools/keyword-miner.mjs), they are research for the previous
# project's subjects, and nothing in the current tree reads them. They were archived outside the
# repository and removed from tracking on 2026-10-26; the files stay on disk.
#
# The rule names the two extensions the generator writes, not the directory: a hand-written seed list
# or a curated note in the same folder should still be committable.
data/keywords/*.csv
data/keywords/*.log

