# Cloudflare Pages headers — copied verbatim into dist/ by Astro.
# spec §2 runs the site on CF Pages, so this is where security headers live.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  #
  # HSTS. Added 2026-10-10.
  #
  # max-age is 180 days and preload is deliberately NOT set. Both are the cautious choice, and the
  # reason is the same: with preload, a browser refuses to connect over http to this host ever
  # again, and the only way back is a removal request that takes months. The site is served only
  # over https (Cloudflare redirects, and the canonical URLs are https), so the practical exposure
  # is nil - but a preload list is not something to join on the same day the header is first
  # served, because a mistake in it is not reversible on any useful timescale. Promote to a year
  # plus preload once the header has been live and unremarked for a while.
  #
  # includeSubDomains is set because the only subdomain the operator controls is www, and it is
  # meant to redirect to the apex. If a subdomain is ever added that cannot serve https, this line
  # has to come out before that happens.
  Strict-Transport-Security: max-age=15552000; includeSubDomains
  # No analytics, no ad networks — so nothing third-party needs allowing.
  #
  # Content-Security-Policy is generated by Astro (security.csp in astro.config.mjs)
  # and emitted as a meta tag, because a hand-written script-src cannot know the
  # hashes of the scripts Astro emits. Do not put a hand-written CSP back here: two
  # policies intersect and the stricter one wins.
  #
  # This line used to read `script-src 'self'`, and Astro inlines page scripts by
  # default, so the browser refused every one of them. The mobile Menu button did
  # nothing, and no build, gate or deploy reported it — it took a real browser
  # clicking the button to find out.
  #
  # frame-ancestors lives here rather than in the meta policy because a browser
  # ignores that directive when it arrives via <meta>, which it warns about on every
  # page load. X-Frame-Options above already denies framing; this is the modern
  # spelling of the same rule.
  Content-Security-Policy: frame-ancestors 'none'
  #
  # ---------------------------------------------------------------------------------------------
  # HTML at the edge. Added 2026-10-10. READ THIS BEFORE ASSUMING CACHING WORKS.
  #
  # Measured before writing it: every HTML response carried `Cache-Control: public, max-age=0,
  # must-revalidate` with `cf-cache-status: DYNAMIC`, so no page was cached and every request came
  # back to the origin. The asset rule below was already working, which is how the difference showed
  # up: /og-default.png returned a MISS while the HTML returned DYNAMIC on every hit.
  #
  # THIS HEADER IS A NECESSARY CONDITION AND NOT A SUFFICIENT ONE. `s-maxage` says how long something
  # may be cached, not whether it may be cached at all, and Cloudflare Pages treats HTML as dynamic
  # until told otherwise. The result is a header that reads correctly in the source, is present in
  # the response, passes every gate, and changes nothing - which is worse than having no header,
  # because it invites the belief that caching is handled.
  #
  # Two conditions must both hold:
  #
  #   1. No Set-Cookie on the response. Verified: this site sets none.
  #   2. A Cache Rule in the Cloudflare dashboard marking these paths cacheable. NOT DONE - it is a
  #      dashboard change and cannot be made from this repository.
  #
  #        Cloudflare dashboard -> Caching -> Cache Rules -> Create rule
  #          When incoming requests match : hostname equals www.toolsai.club
  #          Then : Eligible for cache;  Edge TTL -> "Use cache-control header if present"
  #
  # The header is kept because the rule is useless without it: the rule defers to the origin's
  # s-maxage for the duration. Once the site is live, request a page twice and read `cf-cache-status`;
  # a HIT is the only proof, and until then this directive
  # does nothing at all. That tool is the check, not this comment.
  #
  # The split between the directives is the point:
  #
  #   - `max-age=0` is for the browser. A reader who reloads gets the current page, never a stale
  #     copy held on their machine. This site publishes corrections and they have to land at once.
  #   - `s-maxage=604800` is for the edge, once the Cache Rule exists. A week is safe because a
  #     deploy purges it.
  #   - `stale-while-revalidate=86400` lets the edge serve while it refreshes behind the reader.
  #
  # This sits in the same block as the security headers rather than in a second `/*` block: two
  # blocks matching the same path both apply, which reads as two rules that might conflict, and the
  # first version of this change left the second block unterminated at the end of the file.
  # ---------------------------------------------------------------------------------------------
  Cache-Control: public, max-age=0, s-maxage=604800, stale-while-revalidate=86400

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/og-default.png
  Cache-Control: public, max-age=604800
