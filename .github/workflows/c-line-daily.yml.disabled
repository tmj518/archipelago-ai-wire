# The C line: guides for people moving to, working in or visiting China.
#
# Deliberately a separate file from daily.yml. The trade pipeline's cron, steps and gates are not
# referenced here and are not modified by it; this workflow can fail every day for a month without
# touching the A or B route.
#
# What it shares with the trade line is the repository and therefore one `astro build`. That is the
# only shared failure mode, and tools/c-line-orchestrator.mjs handles it the only way that works:
# the guide is written, the site is built, and on failure the guide is removed before this workflow
# can commit it. A bad guide never reaches main.
name: C line

on:
  schedule:
    # 15:20 Beijing (07:20 UTC). Clear of the trade crons at 23:20, 01:20, 12:20 and 13:20 UTC so the
    # two workflows never contend for the same runner minute.
    - cron: '20 7 * * *'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: c-line
  cancel-in-progress: false

jobs:
  guide:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@v5
        with:
          fetch-depth: 1

      - uses: actions/setup-node@v5
        with:
          node-version: '24'

      - name: Install dependencies
        run: |
          corepack enable
          pnpm install --frozen-lockfile

      #
      # The endpoint is a secret, the model name is an endpoint id, and both are the same two names the
      # trade line already uses. Nothing new to configure.
      #
      - name: Write one guide
        id: run
        env:
          ARK_API_KEY: ${{ secrets.ARK_API_KEY || secrets.DUBAO201628 }}
          ARK_MODEL_WRITER: ${{ secrets.ARK_MODEL_WRITER || secrets.DUBAOTUILI12345 }}
        run: node tools/c-line-orchestrator.mjs

      #
      # Remove the date-suffixed near-duplicates the trade line leaves behind. It reports by default and
      # deletes only when the title is byte-identical to the surviving file, so a real article whose slug
      # happens to carry a date is never touched.
      #
      - name: Remove date-suffixed duplicates
        if: always()
        run: node tools/cleanup-duplicates.mjs --apply

      #
      # Commit only if something actually changed. The orchestrator already removed any guide whose build
      # failed, so what is on disk here has been verified against a real build.
      #
      - name: Commit the guide
        if: always()
        run: |
          if [ -z "$(git status --porcelain src/content data/guide-queue.json data/runs)" ]; then
            echo "nothing to commit - no guide was published and no duplicate was found"
            exit 0
          fi
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add -A src/content data/guide-queue.json data/runs
          # Only exists once the cleaner has actually deleted something; `git add` on a missing path is a
          # fatal, which failed this step on the first run that found no duplicates.
          [ -f data/cleanup.log ] && git add data/cleanup.log || true
          git commit -m "c-line: $(date -u +%F) guide run"
          git pull --rebase --autostash origin main || true
          git push

      #
      # The operator's ledger. tools/feishu-run-ledger.mjs reads data/runs and writes one row per run
      # with 路线 = c, into the same 运行台账 table the trade line writes to. No new table, no schema
      # change - the route column is what tells them apart.
      #
      - name: Record the run in the Feishu ledger
        if: always()
        continue-on-error: true
        env:
          FEISHU_APP_ID: ${{ secrets.FEISHU_APP_ID }}
          FEISHU_APP_SECRET: ${{ secrets.FEISHU_APP_SECRET }}
          FEISHU_APP_TOKEN: ${{ secrets.FEISHU_APP_TOKEN }}
        run: node tools/feishu-run-ledger.mjs --limit=5

      #
      # The corpus, measured rather than described. Every published piece in one row: figures, internal
      # links in and out, and whether a title or a target keyword collides with another piece.
      #
      # It reconciles the whole corpus each run, not just today's article, so an article the trade line
      # published at 07:20 is picked up here at 15:20 and one published at 20:20 is picked up tomorrow.
      # --with-gates runs qa-check per analysis; that is the only slow part and it is worth the minute.
      #
      - name: Record what is published in the content ledger
        if: always()
        continue-on-error: true
        env:
          FEISHU_APP_ID: ${{ secrets.FEISHU_APP_ID }}
          FEISHU_APP_SECRET: ${{ secrets.FEISHU_APP_SECRET }}
          FEISHU_APP_TOKEN: ${{ secrets.FEISHU_APP_TOKEN }}
        run: node tools/content-ledger.mjs --with-gates --prune

      - name: Report the verdict
        if: always()
        run: |
          V=$(node -e "try{console.log(JSON.parse(require('fs').readFileSync('data/runs/latest-c.json','utf8')).verdict)}catch{console.log('NO-RECORD')}")
          echo "verdict: $V"
          echo "### C line: $V" >> "$GITHUB_STEP_SUMMARY"
          node -e "try{const r=JSON.parse(require('fs').readFileSync('data/runs/latest-c.json','utf8'));console.log('| field | value |\n| --- | --- |\n| verdict | '+r.verdict+' |\n| article | '+(r.article||'-')+' |\n| seconds | '+r.seconds+' |\n| cost | \$'+Number(r.usage?.usd||0).toFixed(4)+' |\n| reason | '+((r.reasons||[]).join('; ')||'-')+' |')}catch{}" >> "$GITHUB_STEP_SUMMARY"
          case "$V" in
            PUBLISHED|NO-SUBJECT|DRY-RUN|NO-KEYS) exit 0 ;;
            *) exit 1 ;;
          esac

      #
      # The card, through the one channel that does not need the app token.
      #
      # The Feishu ledger writes through the open API, which answers 21001 when the app is restricted;
      # the webhook is a different mechanism and keeps working. For three months of no supervision this
      # is the difference between "quiet because nothing happened" and "quiet because nobody can see".
      #
      - name: Tell the phone
        if: always()
        continue-on-error: true
        env:
          FEISHU_WEBHOOK: ${{ secrets.FEISHU_WEBHOOK }}
          FEISHU_SECRET: ${{ secrets.FEISHU_SECRET }}
          ROUTE: c
        run: |
          mkdir -p data/tmp
          node -e "const fs=require('fs');try{fs.writeFileSync('data/tmp/orchestrator-report.json',fs.readFileSync('data/runs/latest-c.json'))}catch{fs.writeFileSync('data/tmp/orchestrator-report.json','{\"verdict\":\"NO-RECORD\",\"reasons\":[\"the run wrote no record\"]}')}"
          node tools/notify-feishu.mjs
