# 豆包 ARK API 配置（OpenAI 兼容端点）
# 在 https://console.volcengine.com/ark 创建 API Key 后填入
#
# 写稿用模型（Agent 3/4/7/8/9）
ARK_API_KEY=your_ark_api_key_here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
WRITER_MODEL=doubao-pro-32k

# 质检用模型（Agent 2/5/6/10）——写稿/质检分离，不同模型实例
AUDITOR_MODEL=doubao-pro-128k

# GPTResearcher（Agent 4 深度研究，也走豆包端点）
# 如不填则用 duckduckgo-search 免费后端
# OPENAI_API_KEY 与 ARK_API_KEY 同一个值
